---
const { href, labelEn, labelHi, class: className } = Astro.props;

const currentLang = Astro.currentLocale || "en";
const label = currentLang === "hi" ? labelHi : labelEn;

const getLink = (path: string) => {
    if (currentLang === "en") return path;
    if (path === "/") return "/hi";
    if (path.startsWith("/hi/") || path === "/hi") return path;
    return `/hi${path}`;
};
---

<a href={getLink(href)} class:list={["cta-link", className]}>
    <div class="cta-shimmer"></div>

    <div class="cta-label-container">
        <span class="cta-text">{label}</span>
    </div>

    <div class="icon-circle">
        <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
        >
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
    </div>
</a>

<style>
    .cta-link {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        margin-top: 24px;
        padding: 12px 26px;
        background: var(--primary);
        color: #ffffff;
        border-radius: 99px;
        font-family: var(--font-sans-en);
        font-weight: 700;
        font-size: 0.98rem;
        letter-spacing: -0.01em;
        text-decoration: none;
        box-shadow: var(--shadow-sm);
        border: 1px solid rgba(255, 255, 255, 0.18);
        isolation: isolate;
        overflow: hidden;
        width: fit-content;
        max-width: 100%;
        will-change: transform;
        transition:
            transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
            box-shadow 0.25s ease;
    }

    :global([data-theme="dark"]) .cta-link {
        color: oklch(15% 0.02 155);
        border-color: rgba(255, 255, 255, 0.25);
    }

    :global(:lang(hi)) .cta-link {
        font-family: var(--font-sans-hi);
        font-weight: 700;
        letter-spacing: normal;
    }

    .cta-label-container {
        flex: 1;
        min-width: 0;
        display: flex;
        align-items: center;
    }

    .cta-text {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        display: block;
        width: 100%;
        line-height: 1.2;
    }

    :global(:lang(hi)) .cta-text {
        line-height: 1.4;
        font-size: 0.96rem;
    }

    .cta-shimmer {
        position: absolute;
        inset: 0;
        background: linear-gradient(
            90deg,
            rgba(255, 255, 255, 0) 0%,
            rgba(255, 255, 255, 0.22) 50%,
            rgba(255, 255, 255, 0) 100%
        );
        transform: translateX(-100%) skewX(-15deg);
        transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        z-index: 1;
    }

    .icon-circle {
        display: flex;
        flex-shrink: 0;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
        background: rgba(255, 255, 255, 0.18);
        border-radius: 50%;
        z-index: 2;
        transition:
            transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
            background-color 0.25s ease;
    }

    :global([data-theme="dark"]) .icon-circle {
        background: rgba(15, 25, 20, 0.14);
    }

    .cta-link svg {
        width: 13px;
        height: 13px;
        stroke: currentColor;
        transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .cta-link:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow);
    }

    .cta-link:hover .cta-shimmer {
        transform: translateX(100%) skewX(-15deg);
    }

    .cta-link:hover .icon-circle {
        transform: scale(1.06);
    }

    .cta-link:hover svg {
        transform: translateX(1.5px);
    }

    .cta-link:active {
        transform: translateY(-1px) scale(0.98);
    }

    @media (max-width: 768px) {
        .cta-link {
            padding: 10px 20px;
            font-size: 0.9rem;
            margin-top: 16px;
            gap: 10px;
        }

        .icon-circle {
            width: 24px;
            height: 24px;
        }

        .cta-link svg {
            width: 11px;
            height: 11px;
        }
    }
</style>
