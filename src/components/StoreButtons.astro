---
const currentLang = Astro.currentLocale || "en";

const ui = {
    en: {
        iosSmall: "Download on",
        iosStrong: "App Store",
        androidSmall: "Get it on",
        androidStrong: "Google Play",
        ariaIos: "Download on the App Store",
        ariaAndroid: "Get it on Google Play",
    },
    hi: {
        iosSmall: "डाउनलोड करें",
        iosStrong: "App Store",
        androidSmall: "डाउनलोड करें",
        androidStrong: "Google Play",
        ariaIos: "ऐप स्टोर से डाउनलोड करें",
        ariaAndroid: "गूगल प्ले से प्राप्त करें",
    },
};

const t = ui[currentLang as keyof typeof ui] || ui.en;

interface Props {
    centered?: boolean;
    inverted?: boolean;
    compact?: boolean;
    iosHref?: string;
    androidHref?: string;
    class?: string;
}

const {
    centered = false,
    inverted = false,
    compact = false,
    iosHref = "https://apps.apple.com/in/app/tulaa-yoga-wellness/id6748626498",
    androidHref = "https://play.google.com/store/apps/details?id=life.tulaa",
    class: className,
} = Astro.props;

const iosIconSrc = "/assets/icons/appstore.svg";
const androidIconSrc = "/assets/icons/playstore.svg";
---

<div class:list={["store-buttons", { centered, compact }, className]}>
    <a
        href={iosHref}
        class:list={["store-btn", { inverted }]}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={t.ariaIos}
    >
        <img
            src={iosIconSrc}
            alt=""
            class="store-btn__icon"
            width="22"
            height="22"
            aria-hidden="true"
        />
        <span class="store-btn__text">
            <small>{t.iosSmall}</small>
            <strong>{t.iosStrong}</strong>
        </span>
    </a>

    <a
        href={androidHref}
        class:list={["store-btn", { inverted }]}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={t.ariaAndroid}
    >
        <img
            src={androidIconSrc}
            alt=""
            class="store-btn__icon"
            width="22"
            height="22"
            aria-hidden="true"
        />
        <span class="store-btn__text">
            <small>{t.androidSmall}</small>
            <strong>{t.androidStrong}</strong>
        </span>
    </a>
</div>

<style>
    .store-buttons {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        width: 100%;
    }

    .store-buttons.centered {
        justify-content: center;
    }

    .store-btn {
        --btn-h: 48px;
        height: var(--btn-h);
        border-radius: 99px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 0 18px;
        text-decoration: none;
        white-space: nowrap;
        font-family: var(--font-sans-en);
        transition:
            transform 0.2s cubic-bezier(0.16, 1, 0.3, 1),
            box-shadow 0.2s ease,
            border-color 0.2s ease,
            background 0.2s ease;
        flex: 1 1 138px;
        max-width: 176px;
        background: linear-gradient(180deg, #1b241f 0%, #111714 100%);
        color: #ffffff;
        border: 1px solid rgba(255, 255, 255, 0.22);
        box-shadow: 0 6px 16px -4px rgba(0, 0, 0, 0.25);
    }

    :global([data-theme="dark"]) .store-btn {
        background: linear-gradient(
            180deg,
            rgba(48, 68, 57, 0.95) 0%,
            rgba(31, 45, 38, 0.95) 100%
        );
        border: 1px solid rgba(155, 225, 185, 0.35);
        box-shadow:
            0 6px 20px -4px rgba(0, 0, 0, 0.45),
            inset 0 1px 0 rgba(255, 255, 255, 0.12);
    }

    .store-buttons.compact .store-btn {
        --btn-h: 44px;
        padding: 0 16px;
    }

    @media (min-width: 769px) {
        .store-btn {
            flex: initial;
            max-width: none;
            padding: 0 20px;
            --btn-h: 50px;
        }
        .store-buttons.compact .store-btn {
            --btn-h: 46px;
            padding: 0 18px;
        }
    }

    :global(:lang(hi)) .store-btn {
        font-family: var(--font-sans-hi);
    }

    .store-btn.inverted {
        background: linear-gradient(180deg, var(--bg-main), var(--bg-sub) 60%);
        color: var(--text-main);
        border: 1px solid var(--border-strong);
        box-shadow: var(--shadow-sm);
    }

    .store-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 22px -4px rgba(0, 0, 0, 0.28);
        border-color: var(--primary);
    }

    :global([data-theme="dark"]) .store-btn:hover {
        background: linear-gradient(
            180deg,
            rgba(60, 86, 72, 1) 0%,
            rgba(38, 56, 47, 1) 100%
        );
        border-color: var(--primary);
    }

    .store-btn:active {
        transform: translateY(0);
    }

    .store-btn__icon {
        width: 20px;
        height: 20px;
        object-fit: contain;
        flex-shrink: 0;
    }

    :global([data-theme="light"]) .store-btn.inverted .store-btn__icon {
        filter: brightness(0.2);
    }

    .store-btn__text {
        display: flex;
        flex-direction: column;
        line-height: 1.1;
        text-align: left;
    }

    .store-btn__text small {
        font-size: 9.5px;
        text-transform: none;
        opacity: 0.85;
    }

    :global(:lang(hi)) .store-btn__text small {
        line-height: 1.2;
    }

    .store-btn__text strong {
        font-size: 13.5px;
        font-weight: 650;
        letter-spacing: -0.01em;
    }
</style>
