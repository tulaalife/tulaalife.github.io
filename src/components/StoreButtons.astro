---
const currentLang = Astro.currentLocale || "en";

const ui = {
    en: {
        iosSmall: "Download on",
        iosStrong: "App Store",
        androidSmall: "Get it on",
        androidStrong: "Google Play",
        ariaIos: "Download on the App Store",
        ariaAndroid: "Get it on Google Play",
    },
    hi: {
        iosSmall: "डाउनलोड करें",
        iosStrong: "App Store",
        androidSmall: "डाउनलोड करें",
        androidStrong: "Google Play",
        ariaIos: "ऐप स्टोर से डाउनलोड करें",
        ariaAndroid: "गूगल प्ले से प्राप्त करें",
    },
};

const t = ui[currentLang as keyof typeof ui] || ui.en;

interface Props {
    centered?: boolean;
    inverted?: boolean;
    compact?: boolean;
    iosHref?: string;
    androidHref?: string;
    class?: string;
}

const {
    centered = false,
    inverted = false,
    compact = false,
    iosHref = "https://apps.apple.com/in/app/tulaa-yoga-wellness/id6748626498",
    androidHref = "https://play.google.com/store/apps/details?id=life.tulaa",
    class: className,
} = Astro.props;

const iosIconSrc = "/assets/icons/appstore.svg";
const androidIconSrc = "/assets/icons/playstore.svg";
---

<div class:list={["store-buttons", { centered, compact }, className]}>
    <a
        href={iosHref}
        data-store="ios"
        class:list={["store-btn", { inverted }]}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={t.ariaIos}
    >
        <img
            src={iosIconSrc}
            alt=""
            class="store-btn__icon store-icon-ios"
            width="20"
            height="20"
            aria-hidden="true"
        />
        <span class="store-btn__text">
            <small>{t.iosSmall}</small>
            <strong>{t.iosStrong}</strong>
        </span>
    </a>

    <a
        href={androidHref}
        data-store="android"
        class:list={["store-btn", { inverted }]}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={t.ariaAndroid}
    >
        <img
            src={androidIconSrc}
            alt=""
            class="store-btn__icon store-icon-android"
            width="20"
            height="20"
            aria-hidden="true"
        />
        <span class="store-btn__text">
            <small>{t.androidSmall}</small>
            <strong>{t.androidStrong}</strong>
        </span>
    </a>
</div>

<style>
    .store-buttons {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        align-items: center;
        width: 100%;
    }

    .store-buttons.centered {
        justify-content: center;
    }

    /* Base Primary Store Button style */
    .store-btn {
        --btn-h: 48px;
        height: var(--btn-h);
        border-radius: 99px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 0 20px;
        text-decoration: none;
        white-space: nowrap;
        font-family: var(--font-sans-en);
        transition:
            transform 0.2s cubic-bezier(0.16, 1, 0.3, 1),
            box-shadow 0.2s ease,
            border-color 0.2s ease,
            background 0.2s ease,
            opacity 0.2s ease;
        flex: 1 1 138px;
        max-width: 182px;
        background: var(--primary);
        color: #ffffff;
        border: 1px solid color-mix(in srgb, var(--primary) 85%, #ffffff 15%);
        box-shadow: 0 8px 20px -4px var(--primary-glow);
    }

    :global([data-theme="dark"]) .store-btn {
        color: oklch(14% 0.02 155);
        font-weight: 600;
    }

    :global([data-theme="dark"]) .store-btn .store-icon-ios {
        filter: brightness(0.12);
    }

    /* Secondary Store Button style (Platform-Aware) */
    :global(html[data-platform="apple"]) .store-btn[data-store="android"],
    :global(html[data-platform="android"]) .store-btn[data-store="ios"],
    :global(html[data-platform="other"]) .store-btn[data-store="ios"] {
        background: var(--bg-card-inner);
        color: var(--text-main);
        border: 1px solid var(--border-strong);
        box-shadow: none;
        opacity: 0.88;
    }

    :global(html[data-platform="apple"]) .store-btn[data-store="ios"],
    :global(html[data-platform="android"]) .store-btn[data-store="android"],
    :global(html[data-platform="other"]) .store-btn[data-store="android"] {
        order: -1;
    }

    /* Apple icon contrast when iOS button is secondary in light mode */
    :global(html[data-theme="light"][data-platform="android"])
        .store-btn[data-store="ios"]
        .store-icon-ios,
    :global(html[data-theme="light"][data-platform="other"])
        .store-btn[data-store="ios"]
        .store-icon-ios {
        filter: brightness(0.18);
    }

    :global(html[data-theme="dark"][data-platform="android"])
        .store-btn[data-store="ios"]
        .store-icon-ios,
    :global(html[data-theme="dark"][data-platform="other"])
        .store-btn[data-store="ios"]
        .store-icon-ios {
        filter: none;
    }

    .store-buttons.compact .store-btn {
        --btn-h: 44px;
        padding: 0 16px;
    }

    @media (min-width: 769px) {
        .store-btn {
            flex: initial;
            max-width: none;
            padding: 0 22px;
            --btn-h: 50px;
        }
        .store-buttons.compact .store-btn {
            --btn-h: 46px;
            padding: 0 18px;
        }
    }

    :global(:lang(hi)) .store-btn {
        font-family: var(--font-sans-hi);
    }

    .store-btn:hover {
        transform: translateY(-2px);
        border-color: var(--primary);
        opacity: 1;
    }

    .store-btn:active {
        transform: translateY(0);
    }

    .store-btn__icon {
        width: 20px;
        height: 20px;
        object-fit: contain;
        flex-shrink: 0;
    }

    .store-btn__text {
        display: flex;
        flex-direction: column;
        line-height: 1.1;
        text-align: left;
    }

    .store-btn__text small {
        font-size: 9.5px;
        text-transform: none;
        opacity: 0.86;
    }

    :global(:lang(hi)) .store-btn__text small {
        line-height: 1.2;
    }

    .store-btn__text strong {
        font-size: 13.5px;
        font-weight: 700;
        letter-spacing: -0.01em;
    }
</style>
