---
import StoreButtons from "./StoreButtons.astro";

const currentLang = Astro.currentLocale || "en";

const ui = {
    en: {
        titleTop: "Your Everyday",
        titleBottom: "Yoga & Wellness App.",
        subline: "Find your balance with <strong>Tulaa</strong>.",
        pills: ["✦ 100% Free", "✦ Works Offline", "✦ No Login or Ads"],
    },
    hi: {
        titleTop: "आपका रोज़ का",
        titleBottom: "योग और सेहत साथी।",
        subline: "<strong>Tulaa</strong> के साथ अपना संतुलन पाएं।",
        pills: ["✦ 100% फ्री", "✦ बिना इंटरनेट चले", "✦ कोई लॉगिन या विज्ञापन नहीं"],
    },
};

const t = ui[currentLang as keyof typeof ui] || ui.en;

interface Props {
    subline?: string;
}

const { subline = t.subline } = Astro.props;
---

<div class="footer-card-container">
    <div class="footer-card premium-gloss-surface">
        <div class="section-header-center content">
            <div class="sanctuary-emblem">
                <img
                    src="/assets/icons/logo_64.webp"
                    alt="Tulaa"
                    width="44"
                    height="44"
                />
            </div>
            <h2 class="section-title">
                <span class="title-main">{t.titleTop}</span>{" "}
                <span class="text-gradient">{t.titleBottom}</span>
            </h2>

            <p class="sub body-text" set:html={subline} />

            <div class="sanctuary-pills">
                {t.pills.map((pill) => (
                    <span class="s-pill">{pill}</span>
                ))}
            </div>

            <div class="button-container">
                <StoreButtons showBoth={true} centered={true} />
            </div>
        </div>
    </div>
</div>

<style>
    .footer-card-container {
        width: 100%;
        display: flex;
        justify-content: center;
    }

    .footer-card {
        position: relative;
        width: 100%;
        max-width: var(--container-width);
        padding: clamp(1.85rem, 4.5vh, 3.25rem) var(--space-md);
        border-radius: var(--radius-lg);
        overflow: hidden;
        background: linear-gradient(
            145deg,
            rgba(255, 255, 255, 0.96) 0%,
            rgba(241, 248, 244, 0.92) 52%,
            rgba(250, 245, 238, 0.94) 100%
        );
    }

    :global([data-theme="dark"]) .footer-card {
        background: linear-gradient(
            145deg,
            rgba(28, 41, 35, 0.94) 0%,
            rgba(22, 32, 27, 0.96) 55%,
            rgba(33, 41, 33, 0.92) 100%
        );
    }

    .content {
        position: relative;
        z-index: 2;
        max-width: 680px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
    }

    .sanctuary-emblem {
        width: 54px;
        height: 54px;
        border-radius: 16px;
        padding: 4px;
        background: var(--bg-card-inner);
        border: 1px solid var(--border-strong);
        box-shadow: var(--shadow-sm);
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 2px;
    }

    .sanctuary-emblem img {
        width: 100%;
        height: 100%;
        border-radius: 12px;
        object-fit: cover;
    }

    .section-title {
        font-size: clamp(1.9rem, 4.6vw, 3.2rem);
        letter-spacing: -0.03em;
        line-height: 1.12;
    }

    .title-main {
        color: var(--text-main);
    }

    .sub {
        font-size: clamp(0.92rem, 1.6vw, 1.08rem);
        line-height: 1.55;
        max-width: 52ch;
        margin: 0 auto;
        color: var(--text-muted);
    }

    .sub :global(strong) {
        color: var(--text-main);
        font-weight: 700;
    }

    .sanctuary-pills {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 8px;
        margin: 4px 0 6px;
    }

    .s-pill {
        font-size: 0.78rem;
        font-weight: 650;
        padding: 5px 12px;
        border-radius: 999px;
        background: var(--bg-card-inner);
        border: 1px solid var(--border);
        color: var(--text-main);
    }

    .button-container {
        width: 100%;
        max-width: 380px;
        margin: 4px auto 0;
    }

    @media (max-width: 680px) {
        .footer-card {
            padding: 1.5rem 1rem;
        }

        .sanctuary-emblem {
            width: 44px;
            height: 44px;
            border-radius: 13px;
        }

        .section-title {
            font-size: clamp(1.6rem, 6vw, 2.15rem);
        }

        .s-pill {
            font-size: 0.72rem;
            padding: 4px 10px;
        }
    }
</style>
