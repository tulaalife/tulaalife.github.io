---
import StoreButtons from "./StoreButtons.astro";

const currentLang = Astro.currentLocale || "en";

const ui = {
    en: {
        badge: "No OTP • No Ads • No Subscriptions",
        titleTop: "Your Daily",
        titleBottom: "Health Sanctuary.",
        subline:
            "Open Tulaa and start practicing immediately. <strong>100% Free, Offline-First, and On-Device Private</strong>—no phone number or email required.",
    },
    hi: {
        badge: "बिना OTP • बिना विज्ञापन • बिना सब्सक्रिप्शन",
        titleTop: "आपका दैनिक",
        titleBottom: "स्वास्थ्य और योग साथी।",
        subline:
            "बिना मोबाइल नंबर या ईमेल के तुरंत योग व ध्यान शुरू करें। <strong>100% फ्री, ऑफलाइन और आपके फोन में सुरक्षित।</strong>",
    },
};

const t = ui[currentLang as keyof typeof ui] || ui.en;

interface Props {
    headline?: string;
    subline?: string;
}

const { subline = t.subline } = Astro.props;
---

<section class="footer-card-container">
    <div class="footer-card premium-gloss-surface">
        <div class="section-header-center content">
            <span class="badge-small" style="margin-bottom: 14px;">{t.badge}</span>
            <h2 class="section-title">
                <span class="title-main">{t.titleTop}</span>
                <br />
                <span class="text-gradient">{t.titleBottom}</span>
            </h2>

            <p class="sub body-text" set:html={subline} />

            <div class="button-container">
                <StoreButtons centered={true} />
            </div>
        </div>
    </div>
</section>

<style>
    .footer-card-container {
        width: 100%;
        display: flex;
        justify-content: center;
        padding-top: var(--section-v-padding);
        padding-bottom: var(--section-v-padding);
    }

    .footer-card {
        width: 100%;
        max-width: var(--container-width);
        padding: clamp(2.5rem, 6vh, 4.5rem) var(--space-md);
        border-radius: var(--radius-lg);
        overflow: hidden;
        background: linear-gradient(
            135deg,
            color-mix(in srgb, var(--bg-main), var(--text-main) 1%) 0%,
            color-mix(in srgb, var(--bg-sub), transparent 30%) 100%
        );
    }

    :global([data-theme="dark"]) .footer-card {
        background: linear-gradient(
            135deg,
            color-mix(in srgb, var(--bg-sub), var(--text-main) 2%) 0%,
            var(--bg-main) 100%
        );
    }

    .content {
        max-width: 700px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .section-title {
        font-size: clamp(2.2rem, 5.5vw, 3.6rem);
        margin-bottom: var(--space-sm);
        letter-spacing: -0.035em;
        line-height: 1.12;
    }

    .title-main {
        color: var(--text-main);
    }

    .sub {
        font-size: clamp(1.05rem, 2vw, 1.25rem);
        line-height: 1.65;
        margin-bottom: var(--space-lg);
        max-width: 54ch;
        margin-left: auto;
        margin-right: auto;
        color: var(--text-muted);
    }

    .sub :global(strong) {
        color: var(--text-main);
        font-weight: 750;
    }

    .button-container {
        width: 100%;
        max-width: 370px;
        margin: 0 auto;
        will-change: transform;
        transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .button-container:hover {
        transform: translateY(-3px);
    }

    .button-container:active {
        transform: translateY(-1px) scale(0.99);
    }

    :lang(hi) .section-title {
        line-height: 1.35;
    }
    :lang(hi) .sub {
        line-height: 1.65;
    }

    @media (max-height: 740px) {
        .footer-card-container {
            padding-top: var(--space-md);
            padding-bottom: var(--space-md);
        }
        .footer-card {
            padding: var(--space-lg) var(--space-md);
        }
        .section-title {
            font-size: 2rem;
            margin-bottom: var(--space-xs);
        }
        .sub {
            font-size: 1rem;
            margin-bottom: var(--space-md);
        }
    }

    @media (max-width: 768px) {
        .footer-card {
            padding: var(--space-xl) var(--space-sm);
            border-radius: var(--radius-lg);
        }
    }
</style>
