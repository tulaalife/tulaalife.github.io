---
import Site from "../layouts/Site.astro";
import CTAButton from "./CTAButton.astro";
import StoreButtons from "./StoreButtons.astro";
import type { YogaPlanPreview } from "../data/types";

interface Props {
    plan: YogaPlanPreview;
    canonicalPath: string;
    lang: string;
    labels: {
        back: string;
        openApp: string;
        browse: string;
    };
    backLink?: string;
    browseLink?: string;
}

const { plan, canonicalPath, lang, labels, backLink, browseLink } = Astro.props;

const translations = {
    en: {
        benefitsLabel: "Key Benefits",
        cautionsLabel: "Safety & Cautions",
        intensityLabel: "Level",
        frequencyLabel: "Frequency",
        bestTimeLabel: "Best Time",
        mealGapLabel: "Meal Gap",
        intensityValues: {
            beginner: "Beginner Friendly",
            intermediate: "Intermediate",
            advanced: "Advanced",
        } as Record<string, string>,
        frequencyValues: {
            daily: "Daily Practice",
            weekly_3_5: "3–5x per Week",
            weekly_1_2: "1–2x per Week",
            as_needed: "As Needed",
        } as Record<string, string>,
        timeValues: {
            morning: "Morning",
            afternoon: "Afternoon",
            evening: "Evening",
            night: "Night",
            anytime: "Anytime",
        } as Record<string, string>,
        mealValues: {
            anytime: "Anytime",
            after_15_minutes: "15 mins after meal",
            after_1_hour: "1 hour after meal",
            after_2_hours: "2 hours after meal",
        } as Record<string, string>,
    },
    hi: {
        benefitsLabel: "मुख्य लाभ",
        cautionsLabel: "सावधानियां",
        intensityLabel: "स्तर",
        frequencyLabel: "अभ्यास आवृत्ति",
        bestTimeLabel: "उचित समय",
        mealGapLabel: "भोजन के बाद",
        intensityValues: {
            beginner: "शुरुआती (Beginner)",
            intermediate: "मध्यम (Intermediate)",
            advanced: "उन्नत (Advanced)",
        } as Record<string, string>,
        frequencyValues: {
            daily: "प्रतिदिन",
            weekly_3_5: "सप्ताह में 3–5 बार",
            weekly_1_2: "सप्ताह में 1–2 बार",
            as_needed: "आवश्यकतानुसार",
        } as Record<string, string>,
        timeValues: {
            morning: "सुबह",
            afternoon: "दोपहर",
            evening: "शाम",
            night: "रात",
            anytime: "कभी भी",
        } as Record<string, string>,
        mealValues: {
            anytime: "कभी भी",
            after_15_minutes: "भोजन के 15 मिनट बाद",
            after_1_hour: "भोजन के 1 घंटे बाद",
            after_2_hours: "भोजन के 2 घंटे बाद",
        } as Record<string, string>,
    },
};

const t = translations[lang as keyof typeof translations] || translations.en;

const benefitsList = plan.benefits
    ? plan.benefits
          .split(/\s*[,\n·]\s*/)
          .map((b) => b.trim())
          .filter(Boolean)
    : [];

const cautionsList = plan.cautions
    ? plan.cautions
          .split(/\n+/)
          .map((c) => c.trim())
          .filter(Boolean)
    : [];

const intensityText = plan.intensity
    ? t.intensityValues[plan.intensity] || plan.intensity
    : "";
const frequencyText = plan.practiceFrequency
    ? t.frequencyValues[plan.practiceFrequency] || plan.practiceFrequency
    : "";
const bestTimeText =
    plan.suitableTimeOfDay && plan.suitableTimeOfDay.length > 0
        ? plan.suitableTimeOfDay
              .map((time) => t.timeValues[time] || time)
              .join(", ")
        : t.timeValues.anytime;
const mealGapText = plan.minMealGap
    ? t.mealValues[plan.minMealGap] || plan.minMealGap
    : "";

const hasQuickSpecs = Boolean(
    intensityText || frequencyText || bestTimeText || mealGapText,
);

const finalBackLink = backLink || `/${lang}/yoga`;
const finalBrowseLink = browseLink || `/${lang}/yoga`;

const structuredData = {
    "@context": "https://schema.org",
    "@type": "ExercisePlan",
    name: plan.title,
    alternateName: plan.subtitle,
    description: plan.description,
    image: plan.image,
    url: `https://tulaalife.com${canonicalPath}`,
    inLanguage: lang === "hi" ? "hi-IN" : "en-US",
    exerciseType: "Therapeutic Yoga",
    activityFrequency: frequencyText || "Daily",
    intensity: intensityText || "Beginner",
    isAccessibleForFree: true,
    author: {
        "@type": "Person",
        name: "Latika Bissa",
        jobTitle: "International Yoga Therapist (M.Sc. Gold Medalist)",
    },
    provider: {
        "@type": "Organization",
        name: "Tulaa",
        url: "https://tulaalife.com",
    },
};
---

<Site
    title={`${plan.title} · Yoga Plan · Tulaa`}
    description={plan.description ||
        plan.subtitle ||
        "Gentle preview of this Tulaa yoga plan."}
    canonicalPath={canonicalPath}
    ogImage={plan.image}
    hasTranslation={true}
>
    <div class="content-shell">
        <article class="plan-card">
            <nav class="plan-nav">
                <a
                    href={finalBackLink}
                    class="back-link"
                    data-smart-back="true"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <path d="m15 18-6-6 6-6"></path>
                    </svg>
                    {lang === "hi" ? "वापस जाएं" : "Back"}
                </a>
            </nav>

            <div class="image-hero">
                <div class="image-frame themed-media">
                    <img
                        src={plan.image}
                        alt={plan.title}
                        width="1200"
                        height="630"
                        loading="eager"
                    />
                </div>
            </div>

            <div class="section-header-left plan-header">
                <h1 class="plan-title section-title">{plan.title}</h1>
                {
                    plan.subtitle && (
                        <p
                            class="plan-subtitle body-text"
                            style="margin-top: 8px;"
                        >
                            {plan.subtitle}
                        </p>
                    )
                }
            </div>

            <div class="plan-body">
                {
                    hasQuickSpecs && (
                        <div class="specs-grid">
                            {intensityText && (
                                <div class="spec-chip">
                                    <span class="spec-label">{t.intensityLabel}</span>
                                    <strong class="spec-val">{intensityText}</strong>
                                </div>
                            )}
                            {frequencyText && (
                                <div class="spec-chip">
                                    <span class="spec-label">{t.frequencyLabel}</span>
                                    <strong class="spec-val">{frequencyText}</strong>
                                </div>
                            )}
                            {bestTimeText && (
                                <div class="spec-chip">
                                    <span class="spec-label">{t.bestTimeLabel}</span>
                                    <strong class="spec-val">{bestTimeText}</strong>
                                </div>
                            )}
                            {mealGapText && (
                                <div class="spec-chip">
                                    <span class="spec-label">{t.mealGapLabel}</span>
                                    <strong class="spec-val">{mealGapText}</strong>
                                </div>
                            )}
                        </div>
                    )
                }

                {
                    plan.description && (
                        <p class="plan-lead body-text">{plan.description}</p>
                    )
                }

                {
                    benefitsList.length > 0 && (
                        <div class="benefits-module">
                            <h2 class="benefits-label">{t.benefitsLabel}</h2>
                            <ul class="benefits-list">
                                {benefitsList.map((benefit) => (
                                    <li>{benefit}</li>
                                ))}
                            </ul>
                        </div>
                    )
                }

                {
                    cautionsList.length > 0 && (
                        <aside class="cautions-module" role="note">
                            <h2 class="cautions-label">{t.cautionsLabel}</h2>
                            <ul class="cautions-list">
                                {cautionsList.map((caution) => (
                                    <li>{caution}</li>
                                ))}
                            </ul>
                        </aside>
                    )
                }
            </div>

            <footer class="plan-footer">
                <div class="button-group">
                    <StoreButtons appPath={`yoga/${plan.slug}`} />

                    <CTAButton
                        href={finalBrowseLink}
                        label={labels.browse}
                        variant="soft"
                        size="md"
                    />
                </div>
            </footer>
        </article>

        <script
            type="application/ld+json"
            set:html={JSON.stringify(structuredData)}
        />
    </div>
</Site>

<style>
    .content-shell {
        max-width: 760px;
        margin: 0 auto;
        padding: 40px 24px 80px;
    }

    .plan-card {
        display: flex;
        flex-direction: column;
        gap: 32px;
    }

    .plan-nav {
        display: flex;
    }

    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 0.95rem;
        font-weight: 600;
        color: var(--text-muted);
        transition: all 0.2s ease;
    }

    .back-link:hover {
        color: var(--primary);
        transform: translateX(-2px);
    }

    .image-hero {
        margin-top: 4px;
    }

    .image-frame {
        width: 100%;
        border-radius: var(--radius-lg);
        overflow: hidden;
        border: 1px solid var(--border);
        box-shadow: var(--shadow);
        background: var(--bg-sub);
    }

    .image-frame img {
        width: 100%;
        aspect-ratio: 16 / 10;
        max-height: 420px;
        object-fit: cover;
        display: block;
        transition: transform 0.6s ease;
    }

    .image-frame:hover img {
        transform: scale(1.02);
    }

    .plan-header {
        width: 100%;
        text-align: left;
    }

    .plan-title {
        font-size: clamp(2rem, 4vw, 2.75rem);
        text-align: left;
    }

    .plan-subtitle {
        color: var(--text-muted);
        text-align: left;
    }

    .plan-body {
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 28px;
    }

    .plan-lead {
        color: var(--text-main);
        text-align: left;
    }

    .benefits-module {
        background: var(--bg-sub);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        padding: 28px;
        box-shadow: var(--shadow);
        text-align: left;
    }

    .benefits-label {
        font-size: 0.8rem;
        text-transform: uppercase;
        color: var(--primary);
        margin-bottom: 16px;
        font-weight: var(--fw-bold);
        letter-spacing: 0.05em;
    }

    .benefits-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .benefits-list li {
        font-size: 1.05rem;
        line-height: 1.6;
        color: var(--text-main);
        display: flex;
        align-items: flex-start;
        gap: 10px;
    }

    .benefits-list li::before {
        content: "✦";
        color: var(--primary);
        font-size: 0.85rem;
        margin-top: 4px;
        flex-shrink: 0;
    }

    .specs-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 12px;
    }

    .spec-chip {
        background: var(--bg-sub);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 14px 16px;
        display: flex;
        flex-direction: column;
        gap: 4px;
        text-align: left;
    }

    .spec-label {
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--text-muted);
        font-weight: 700;
    }

    .spec-val {
        font-size: 0.95rem;
        color: var(--text-main);
        font-weight: 650;
    }

    .cautions-module {
        background: color-mix(in srgb, #f59e0b 8%, var(--bg-sub));
        border: 1px solid color-mix(in srgb, #f59e0b 28%, var(--border));
        border-radius: var(--radius-lg);
        padding: 24px 28px;
        text-align: left;
    }

    .cautions-label {
        font-size: 0.8rem;
        text-transform: uppercase;
        color: #b45309;
        margin-bottom: 14px;
        font-weight: var(--fw-bold);
        letter-spacing: 0.05em;
    }

    :global([data-theme="dark"]) .cautions-label {
        color: #fbbf24;
    }

    .cautions-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .cautions-list li {
        font-size: 0.98rem;
        line-height: 1.55;
        color: var(--text-main);
        display: flex;
        align-items: flex-start;
        gap: 10px;
    }

    .cautions-list li::before {
        content: "•";
        color: #d97706;
        font-weight: 700;
        flex-shrink: 0;
    }

    .plan-footer {
        margin-top: 16px;
        padding-top: 32px;
        border-top: 1px solid var(--border);
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 20px;
        text-align: left;
    }

    .button-group {
        display: flex;
        gap: 14px;
        flex-wrap: wrap;
        justify-content: flex-start;
    }

    @media (max-width: 600px) {
        .content-shell {
            padding: 24px 16px 60px;
        }

        .image-frame img {
            aspect-ratio: 16 / 11;
            max-height: 250px;
        }

        .plan-title {
            font-size: 1.8rem;
        }

        .plan-lead {
            font-size: 1.05rem;
        }
    }
</style>
