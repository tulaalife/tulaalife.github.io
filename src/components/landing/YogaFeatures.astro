---
import SectionCTA from "../SectionCTA.astro";
import {
    YOGA_UI,
    CATEGORY_MAP,
    type SupportedLang,
} from "../../utils/ui-strings";
import { yogaPlans } from "../../data/generated";

const currentLang = (Astro.currentLocale || "en") as SupportedLang;
const t = YOGA_UI[currentLang] || YOGA_UI.en;
const basePlanHref = currentLang === "hi" ? "/hi/yoga" : "/yoga";

const intensityLabel: Record<string, string> =
    currentLang === "hi"
        ? {
              beginner: "शुरुआती",
              intermediate: "मध्यम",
              advanced: "उन्नत",
          }
        : {
              beginner: "Beginner Safe",
              intermediate: "Intermediate",
              advanced: "Advanced",
          };

const displayPlans = yogaPlans.filter((p) => p.language === currentLang);
---

<section id="yoga-library" class="scroll-section section-yoga">
    <div class="content-wrapper">
        <div class="container header-bar animate-on-scroll">
            <div class="section-header-left text-col">
                <span class="badge-small">
                    {
                        currentLang === "hi"
                            ? "30+ योग थेरेपी प्लान्स"
                            : "30+ Therapeutic Yoga Plans"
                    }
                </span>
                <h2 class="section-title">
                    <span class="title-main">{t.heroTitleTop}</span>{" "}
                    <span class="text-gradient">{t.heroTitleBottom}</span>
                </h2>
                <p class="body-text">{t.heroBody}</p>
            </div>
        </div>

        <div class="container filter-container animate-on-scroll delay-1">
            <div class="filter-scroll">
                <button class="filter-btn active" data-filter="all"
                    >{t.filterAll}</button
                >
                <button class="filter-btn" data-filter="general"
                    >{t.filterGeneral}</button
                >
                <button class="filter-btn" data-filter="womens"
                    >{t.filterWomens}</button
                >
                <button class="filter-btn" data-filter="seniors"
                    >{t.filterSeniors}</button
                >
                <button class="filter-btn" data-filter="medical"
                    >{t.filterMedical}</button
                >
            </div>
        </div>

        <div class="container carousel-wrapper animate-on-scroll delay-2">
            <div class="carousel-track" id="featured-plans-track">
                {
                    displayPlans.map((p) => (
                        <a
                            href={`${basePlanHref}/${p.slug}`}
                            class="carousel-card premium-gloss-surface"
                            data-goals={p.goals?.join(",")}
                        >
                            <div class="card-image">
                                <img
                                    src={p.image}
                                    alt={p.title}
                                    loading="lazy"
                                    decoding="async"
                                />
                                <span class="card-tag">
                                    {p.intensity
                                        ? intensityLabel[p.intensity] ||
                                          p.intensity
                                        : intensityLabel.beginner}
                                </span>
                            </div>
                            <div class="card-content">
                                <div class="card-text-group">
                                    <h3 class="card-title">{p.title}</h3>
                                    {p.subtitle && (
                                        <p class="card-sub">{p.subtitle}</p>
                                    )}
                                </div>
                                <div class="card-footer">
                                    <span class="view-link">{t.view}</span>
                                    <span class="icon">→</span>
                                </div>
                            </div>
                        </a>
                    ))
                }
            </div>
        </div>

        <div class="container cta-wrapper animate-on-scroll delay-2">
            <SectionCTA
                href="/yoga"
                labelEn="Explore All 30+ Plans"
                labelHi="सभी 30+ प्लान देखें"
            />
        </div>
    </div>
</section>

<script is:inline define:vars={{ CATEGORY_MAP }}>
    document.addEventListener("astro:page-load", () => {
        const filterBtns = document.querySelectorAll(".filter-btn");
        const track = document.getElementById("featured-plans-track");
        if (!track || filterBtns.length === 0) return;

        const cards = Array.from(track.querySelectorAll(".carousel-card"));

        filterBtns.forEach((btn) => {
            btn.addEventListener("click", () => {
                filterBtns.forEach((b) => b.classList.remove("active"));
                btn.classList.add("active");

                const filterId = btn.getAttribute("data-filter");

                cards.forEach((card) => {
                    if (filterId === "all") {
                        card.style.display = "flex";
                        setTimeout(() => (card.style.opacity = "1"), 10);
                        return;
                    }

                    const targetGoals = CATEGORY_MAP[filterId] || [];
                    const itemGoals = (
                        card.getAttribute("data-goals") || ""
                    ).split(",");
                    const isMatch = targetGoals.some((goal) =>
                        itemGoals.includes(goal),
                    );

                    if (isMatch) {
                        card.style.display = "flex";
                        setTimeout(() => (card.style.opacity = "1"), 10);
                    } else {
                        card.style.opacity = "0";
                        setTimeout(() => (card.style.display = "none"), 260);
                    }
                });

                track.scrollTo({ left: 0, behavior: "smooth" });
            });
        });
    });
</script>

<style>
    .section-yoga {
        width: 100%;
    }

    .content-wrapper {
        display: flex;
        flex-direction: column;
        width: 100%;
        margin: 0 auto;
        gap: clamp(0.75rem, 2vh, 1.35rem);
    }

    .text-col {
        gap: 8px;
        width: 100%;
    }

    .section-title {
        font-size: clamp(1.9rem, 4.4vw, 3.2rem);
        letter-spacing: -0.03em;
        line-height: 1.12;
        color: var(--text-main);
    }

    .body-text {
        font-size: clamp(0.92rem, 1.6vw, 1.06rem);
        color: var(--text-muted);
        max-width: 56ch;
        line-height: 1.5;
    }

    .filter-container {
        display: flex;
        align-items: center;
        width: 100%;
    }

    .filter-scroll {
        display: flex;
        gap: 8px;
        overflow-x: auto;
        scrollbar-width: none;
        -webkit-overflow-scrolling: touch;
        padding: 2px 0;
    }

    .filter-scroll::-webkit-scrollbar {
        display: none;
    }

    .filter-btn {
        background: var(--bg-card-inner);
        border: 1px solid var(--border);
        color: var(--text-muted);
        padding: 7px 16px;
        border-radius: 99px;
        font-size: 0.82rem;
        font-weight: 650;
        cursor: pointer;
        white-space: nowrap;
        transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .filter-btn:hover {
        border-color: var(--primary);
        color: var(--text-main);
    }

    .filter-btn.active {
        background: var(--primary);
        color: oklch(15% 0.02 155);
        border-color: var(--primary);
    }

    :global([data-theme="light"]) .filter-btn.active {
        color: #ffffff;
    }

    .carousel-wrapper {
        position: relative;
        width: 100%;
    }

    .carousel-wrapper::after {
        content: "";
        position: absolute;
        top: 0;
        right: 0;
        width: 44px;
        height: 100%;
        background: linear-gradient(
            to left,
            var(--bg-main) 0%,
            transparent 100%
        );
        pointer-events: none;
        z-index: 5;
    }

    .carousel-track {
        display: flex;
        gap: 16px;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        padding: 4px 0 8px 0;
        scrollbar-width: none;
        -webkit-overflow-scrolling: touch;
    }

    .carousel-track::-webkit-scrollbar {
        display: none;
    }

    .carousel-card {
        scroll-snap-align: start;
        flex: 0 0 268px;
        display: flex;
        flex-direction: column;
        text-decoration: none;
        color: inherit;
        border-radius: var(--radius-lg);
        overflow: hidden;
        transition:
            transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
            border-color 0.25s ease,
            opacity 0.25s ease;
    }

    .carousel-card:hover {
        transform: translateY(-4px);
        border-color: var(--primary);
    }

    .card-image {
        position: relative;
        aspect-ratio: 16 / 10;
        overflow: hidden;
        border-bottom: 1px solid var(--border);
        background: var(--bg-sub);
    }

    .card-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .carousel-card:hover .card-image img {
        transform: scale(1.04);
    }

    .card-tag {
        position: absolute;
        bottom: 8px;
        left: 10px;
        padding: 3px 9px;
        border-radius: 99px;
        font-size: 0.68rem;
        font-weight: 700;
        background: color-mix(in srgb, var(--bg-main) 86%, transparent);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        color: var(--text-main);
        border: 1px solid var(--border);
    }

    .card-content {
        padding: 14px 16px;
        display: flex;
        flex-direction: column;
        gap: 10px;
        flex-grow: 1;
        justify-content: space-between;
    }

    .card-text-group {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .card-title {
        font-size: 1.05rem;
        font-weight: 700;
        margin: 0;
        color: var(--text-main);
        letter-spacing: -0.015em;
        line-height: 1.3;
        display: -webkit-box;
        -webkit-line-clamp: 1;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .card-sub {
        font-size: 0.8rem;
        color: var(--text-muted);
        margin: 0;
        line-height: 1.35;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .card-footer {
        display: flex;
        align-items: center;
        gap: 6px;
        font-weight: 650;
        color: var(--primary);
        font-size: 0.84rem;
    }

    .icon {
        transition: transform 0.2s ease;
    }

    .carousel-card:hover .icon {
        transform: translateX(3px);
    }

    .cta-wrapper {
        display: flex;
        justify-content: flex-start;
    }

    .cta-wrapper :global(.cta-link) {
        margin-top: 0;
        padding: 11px 24px;
        font-size: 0.95rem;
    }

    @media (max-width: 680px) {
        .section-title {
            font-size: clamp(1.65rem, 6vw, 2.2rem);
        }
        .carousel-card {
            flex: 0 0 232px;
        }
        .card-content {
            padding: 12px 14px;
        }
    }
</style>
