---
import {
    YOGA_UI,
    CATEGORY_MAP,
    type SupportedLang,
} from "../../utils/ui-strings";
import { yogaPlans } from "../../data/generated";
import { seededShuffle } from "../../utils/ordering";

const currentLang = (Astro.currentLocale || "en") as SupportedLang;
const t = YOGA_UI[currentLang] || YOGA_UI.en;
const basePlanHref = currentLang === "hi" ? "/hi/yoga" : "/yoga";

const intensityLabel: Record<string, string> =
    currentLang === "hi"
        ? {
              beginner: "शुरुआती",
              intermediate: "मध्यम",
              advanced: "उन्नत",
          }
        : {
              beginner: "Beginner Safe",
              intermediate: "Intermediate",
              advanced: "Advanced",
          };

const buildDayKey = new Date().toISOString().slice(0, 10);
const displayPlans = seededShuffle(
    yogaPlans.filter((p) => p.language === currentLang),
    `${buildDayKey}:all`,
);
---

<section id="yoga-library" class="scroll-section section-yoga">
    <div class="content-wrapper">
        <div class="container header-bar animate-on-scroll">
            <div class="section-header-left text-col">
                <span class="badge-small">
                    {currentLang === "hi"
                        ? "40+ योग थेरेपी प्लान्स"
                        : "40+ Therapeutic Plans"}
                </span>
                <h2 class="section-title">
                    <span class="title-main">{t.heroTitleTop}</span>{" "}
                    <span class="text-gradient">{t.heroTitleBottom}</span>
                </h2>
            </div>
        </div>

        <div class="container filter-container animate-on-scroll delay-1">
            <div class="filter-scroll">
                <button class="filter-btn active" data-filter="all">
                    {t.filterAll}
                </button>
                <button class="filter-btn" data-filter="general">
                    {t.filterGeneral}
                </button>
                <button class="filter-btn" data-filter="womens">
                    {t.filterWomens}
                </button>
                <button class="filter-btn" data-filter="seniors">
                    {t.filterSeniors}
                </button>
                <button class="filter-btn" data-filter="medical">
                    {t.filterMedical}
                </button>
            </div>
        </div>

        <div class="container carousel-wrapper animate-on-scroll delay-2">
            <div class="carousel-track" id="featured-plans-track">
                {displayPlans.map((p) => (
                    <a
                        href={`${basePlanHref}/${p.slug}`}
                        class="carousel-card premium-gloss-surface"
                        data-goals={p.goals?.join(",")}
                    >
                        <div class="card-image themed-media">
                            <img
                                src={p.image}
                                alt={p.title}
                                loading="lazy"
                                decoding="async"
                            />
                            <span class="card-tag">
                                {p.intensity
                                    ? intensityLabel[p.intensity] || p.intensity
                                    : intensityLabel.beginner}
                            </span>
                        </div>
                        <div class="card-content">
                            <div class="card-text-group">
                                <h3 class="card-title">{p.title}</h3>
                                {p.subtitle && (
                                    <p class="card-sub">{p.subtitle}</p>
                                )}
                            </div>
                            <div class="card-footer">
                                <span class="view-link">{t.view}</span>
                                <span class="icon">→</span>
                            </div>
                        </div>
                    </a>
                ))}
            </div>
        </div>
    </div>
</section>

<script is:inline define:vars={{ CATEGORY_MAP }}>
    document.addEventListener("astro:page-load", () => {
        const filterBtns = document.querySelectorAll(".filter-btn");
        const track = document.getElementById("featured-plans-track");
        if (!track || filterBtns.length === 0) return;

        const allCards = Array.from(track.querySelectorAll(".carousel-card"));

        function getTodaySeedKey() {
            const now = new Date();
            const y = now.getFullYear();
            const m = String(now.getMonth() + 1).padStart(2, "0");
            const d = String(now.getDate()).padStart(2, "0");
            return `${y}-${m}-${d}`;
        }

        function hashSeed(str) {
            let h = 2166136261;
            for (let i = 0; i < str.length; i++) {
                h ^= str.charCodeAt(i);
                h = Math.imul(h, 16777619);
            }
            return h >>> 0;
        }

        function seededShuffle(items, seedStr) {
            const arr = items.slice();
            let a = hashSeed(seedStr) || 1;
            const rand = () => {
                a |= 0;
                a = (a + 0x6d2b79f5) | 0;
                let t = Math.imul(a ^ (a >>> 15), 1 | a);
                t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
                return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
            };
            for (let i = arr.length - 1; i > 0; i--) {
                const j = Math.floor(rand() * (i + 1));
                [arr[i], arr[j]] = [arr[j], arr[i]];
            }
            return arr;
        }

        const canonicalCards = allCards
            .slice()
            .sort((a, b) =>
                (a.getAttribute("href") || "").localeCompare(
                    b.getAttribute("href") || "",
                ),
            );

        const dayKey = getTodaySeedKey();
        const topAllHrefs = new Set(
            seededShuffle(canonicalCards, `${dayKey}:all`)
                .slice(0, 5)
                .map((c) => c.getAttribute("href") || ""),
        );

        function applyCategoryOrder(filterId, shouldScroll = true) {
            const targetGoals = CATEGORY_MAP[filterId] || [];
            const matched = [];
            const unmatched = [];

            canonicalCards.forEach((card) => {
                if (filterId === "all") {
                    matched.push(card);
                    return;
                }
                const itemGoals = (
                    card.getAttribute("data-goals") || ""
                ).split(",");
                const isMatch = targetGoals.some((goal) =>
                    itemGoals.includes(goal),
                );
                if (isMatch) {
                    matched.push(card);
                } else {
                    unmatched.push(card);
                }
            });

            let shuffledMatched = seededShuffle(
                matched,
                `${dayKey}:${filterId}`,
            );

            // Push the first 5 plans from "All Plans" to the end of category filters for freshness
            if (filterId !== "all") {
                const fresh = [];
                const seenInAll = [];
                shuffledMatched.forEach((card) => {
                    if (topAllHrefs.has(card.getAttribute("href") || "")) {
                        seenInAll.push(card);
                    } else {
                        fresh.push(card);
                    }
                });
                shuffledMatched = [...fresh, ...seenInAll];
            }

            const frag = document.createDocumentFragment();
            shuffledMatched.forEach((card) => {
                card.style.display = "flex";
                card.style.opacity = "1";
                frag.appendChild(card);
            });
            unmatched.forEach((card) => {
                card.style.display = "none";
                card.style.opacity = "0";
                frag.appendChild(card);
            });

            track.appendChild(frag);
            if (shouldScroll) {
                track.scrollLeft = 0;
            }
        }

        let fadeTimer = null;

        applyCategoryOrder("all", false);

        filterBtns.forEach((btn) => {
            btn.addEventListener("click", () => {
                if (btn.classList.contains("active")) return;
                filterBtns.forEach((b) => b.classList.remove("active"));
                btn.classList.add("active");

                const filterId = btn.getAttribute("data-filter") || "all";
                if (fadeTimer) clearTimeout(fadeTimer);

                track.classList.add("is-fading");
                fadeTimer = setTimeout(() => {
                    applyCategoryOrder(filterId, true);
                    requestAnimationFrame(() => {
                        track.classList.remove("is-fading");
                    });
                }, 180);
            });
        });
    });
</script>

<style>
    .section-yoga {
        width: 100%;
    }

    .content-wrapper {
        display: flex;
        flex-direction: column;
        width: 100%;
        margin: 0 auto;
        gap: clamp(1.15rem, 2.8vh, 1.75rem);
    }

    .text-col {
        gap: 8px;
        width: 100%;
    }

    .section-title {
        font-size: clamp(1.9rem, 4.4vw, 3.2rem);
        letter-spacing: -0.03em;
        line-height: 1.12;
        color: var(--text-main);
    }

    .body-text {
        font-size: clamp(0.92rem, 1.6vw, 1.06rem);
        color: var(--text-muted);
        max-width: 56ch;
        line-height: 1.5;
    }

    .filter-container {
        display: flex;
        align-items: center;
        width: 100%;
    }

    .filter-scroll {
        display: flex;
        gap: 8px;
        overflow-x: auto;
        scrollbar-width: none;
        -webkit-overflow-scrolling: touch;
        padding: 2px 0;
    }

    .filter-scroll::-webkit-scrollbar {
        display: none;
    }

    .filter-btn {
        background: var(--bg-card-inner);
        border: 1px solid var(--border);
        color: var(--text-muted);
        padding: 7px 16px;
        border-radius: 99px;
        font-size: 0.82rem;
        font-weight: 650;
        cursor: pointer;
        white-space: nowrap;
        transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .filter-btn:hover {
        border-color: var(--primary);
        color: var(--text-main);
    }

    .filter-btn.active {
        background: var(--primary);
        color: oklch(15% 0.02 155);
        border-color: var(--primary);
    }

    :global([data-theme="light"]) .filter-btn.active {
        color: #ffffff;
    }

    .carousel-wrapper {
        position: relative;
        width: 100%;
    }

    .carousel-track {
        display: flex;
        gap: 16px;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        padding: 4px 0 8px 0;
        scrollbar-width: none;
        -webkit-overflow-scrolling: touch;
        opacity: 1;
        transition: opacity 0.24s ease;
    }

    .carousel-track.is-fading {
        opacity: 0;
        transition: opacity 0.16s ease;
    }

    .carousel-track::-webkit-scrollbar {
        display: none;
    }

    .carousel-card {
        scroll-snap-align: start;
        flex: 0 0 268px;
        display: flex;
        flex-direction: column;
        text-decoration: none;
        color: inherit;
        border-radius: var(--radius-lg);
        overflow: hidden;
        transition:
            transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
            border-color 0.25s ease,
            opacity 0.25s ease;
    }

    .carousel-card:hover {
        transform: translateY(-4px);
        border-color: var(--primary);
    }

    .card-image {
        position: relative;
        aspect-ratio: 16 / 10;
        overflow: hidden;
        border-bottom: 1px solid var(--border);
        background: var(--bg-sub);
    }

    .card-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .carousel-card:hover .card-image img {
        transform: scale(1.04);
    }

    .card-tag {
        position: absolute;
        bottom: 8px;
        left: 10px;
        padding: 3px 9px;
        border-radius: 99px;
        font-size: 0.68rem;
        font-weight: 700;
        background: color-mix(in srgb, var(--bg-main) 86%, transparent);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        color: var(--text-main);
        border: 1px solid var(--border);
    }

    .card-content {
        padding: 14px 16px;
        display: flex;
        flex-direction: column;
        gap: 10px;
        flex-grow: 1;
        justify-content: space-between;
    }

    .card-text-group {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .card-title {
        font-size: 1.05rem;
        font-weight: 700;
        margin: 0;
        color: var(--text-main);
        letter-spacing: -0.015em;
        line-height: 1.3;
        display: -webkit-box;
        -webkit-line-clamp: 1;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .card-sub {
        font-size: 0.8rem;
        color: var(--text-muted);
        margin: 0;
        line-height: 1.35;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .card-footer {
        display: flex;
        align-items: center;
        gap: 6px;
        font-weight: 650;
        color: var(--primary);
        font-size: 0.84rem;
    }

    .icon {
        transition: transform 0.2s ease;
    }

    .carousel-card:hover .icon {
        transform: translateX(3px);
    }

    @media (max-width: 680px) {
        .section-title {
            font-size: clamp(1.65rem, 6vw, 2.2rem);
        }
        .carousel-card {
            flex: 0 0 232px;
        }
        .card-content {
            padding: 12px 14px;
        }
    }
</style>
