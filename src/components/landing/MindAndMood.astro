---
import SectionCTA from "../SectionCTA.astro";
import { guidedAudios } from "../../data/generated";

const currentLang = Astro.currentLocale || "en";

const ui = {
    en: {
        badge: "Pranayama • Vedic Chants • Sleep Nidra",
        titleTop: "Quiet the Mind,",
        titleBottom: "Sleep Deeper.",
        body: "Reset an overworked nervous system in 5 minutes with guided Nadi Shodhana, Bhramari, Vedic chants, and bedtime relaxation.",
        ctaEn: "Explore Audio Sanctuary",
        ctaHi: "ऑडियो सेशन देखें",
        play: "Listen Session",
        audioTag: "Guided Audio",
    },
    hi: {
        badge: "प्राणायाम • वैदिक मंत्र • योग निद्रा",
        titleTop: "मन को दें शांति,",
        titleBottom: "पाएं गहरी नींद।",
        body: "सिर्फ़ 5 मिनट में तनाव घटाएं — नाड़ी शोधन, भ्रामरी प्राणायाम, वैदिक मंत्र और बेडटाइम मेडिटेशन के साथ।",
        ctaEn: "Explore Audio Sanctuary",
        ctaHi: "ऑडियो सेशन देखें",
        play: "अभी सुनें",
        audioTag: "गाइडेड ऑडियो",
    },
};

const t = ui[currentLang as keyof typeof ui] || ui.en;
const baseAudioHref = currentLang === "hi" ? "/hi/audio" : "/audio";

const displayAudios = guidedAudios
    .filter((a) => a.language === currentLang)
    .slice(0, 8);
---

<section id="mind-sleep" class="scroll-section section-mind">
    <div class="content-wrapper">
        <div class="container">
            <div class="section-header-left text-col animate-on-scroll">
                <span class="badge-small">{t.badge}</span>
                <h2 class="section-title">
                    {t.titleTop}{" "}
                    <span class="text-gradient">{t.titleBottom}</span>
                </h2>
                <p class="body-text">{t.body}</p>
            </div>
        </div>

        <div class="container carousel-wrapper animate-on-scroll delay-1">
            <div class="carousel-track" id="audio-plans-track">
                {
                    displayAudios.map((audio) => (
                        <a
                            href={`${baseAudioHref}/${audio.slug}`}
                            class="carousel-card premium-gloss-surface"
                        >
                            <div class="card-image">
                                <img
                                    src={audio.image}
                                    alt={audio.title}
                                    loading="lazy"
                                    decoding="async"
                                />
                                <div class="play-overlay">
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        viewBox="0 0 24 24"
                                        fill="currentColor"
                                        class="play-icon"
                                    >
                                        <path
                                            fill-rule="evenodd"
                                            d="M4.5 5.653c0-1.426 1.529-2.33 2.779-1.643l11.54 6.348c1.295.712 1.295 2.573 0 3.285L7.28 19.991c-1.25.687-2.779-.217-2.779-1.643V5.653z"
                                            clip-rule="evenodd"
                                        />
                                    </svg>
                                </div>
                                <span class="wave-badge">
                                    <span class="wave-bars" aria-hidden="true">
                                        <i />
                                        <i />
                                        <i />
                                        <i />
                                    </span>
                                    {t.audioTag}
                                </span>
                            </div>
                            <div class="card-content">
                                <div class="card-text-group">
                                    <h3 class="card-title">{audio.title}</h3>
                                    {audio.subtitle && (
                                        <p class="card-sub">{audio.subtitle}</p>
                                    )}
                                </div>
                                <div class="card-footer">
                                    <span class="view-link">{t.play}</span>
                                    <span class="icon">→</span>
                                </div>
                            </div>
                        </a>
                    ))
                }
            </div>
        </div>

        <div class="container cta-wrapper animate-on-scroll delay-2">
            <SectionCTA
                href="/audio"
                labelEn={t.ctaEn}
                labelHi={t.ctaHi}
            />
        </div>
    </div>
</section>

<style>
    .section-mind {
        width: 100%;
    }

    .content-wrapper {
        display: flex;
        flex-direction: column;
        width: 100%;
        margin: 0 auto;
        gap: clamp(0.85rem, 2.2vh, 1.5rem);
    }

    .text-col {
        gap: 8px;
        width: 100%;
    }

    .section-title {
        font-size: clamp(1.9rem, 4.4vw, 3.2rem);
        letter-spacing: -0.03em;
        line-height: 1.12;
        color: var(--text-main);
    }

    .body-text {
        font-size: clamp(0.92rem, 1.6vw, 1.06rem);
        color: var(--text-muted);
        max-width: 56ch;
        line-height: 1.5;
    }

    .carousel-wrapper {
        position: relative;
        width: 100%;
    }

    .carousel-wrapper::after {
        content: "";
        position: absolute;
        top: 0;
        right: 0;
        width: 44px;
        height: 100%;
        background: linear-gradient(
            to left,
            var(--bg-main) 0%,
            transparent 100%
        );
        pointer-events: none;
        z-index: 5;
    }

    .carousel-track {
        display: flex;
        gap: 16px;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        padding: 4px 0 8px 0;
        scrollbar-width: none;
        -webkit-overflow-scrolling: touch;
        position: relative;
        z-index: 2;
    }

    .carousel-track::-webkit-scrollbar {
        display: none;
    }

    .carousel-card {
        scroll-snap-align: start;
        flex: 0 0 268px;
        display: flex;
        flex-direction: column;
        text-decoration: none;
        color: inherit;
        border-radius: var(--radius-lg);
        overflow: hidden;
        transition:
            transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
            border-color 0.25s ease;
    }

    .carousel-card:hover {
        transform: translateY(-4px);
        border-color: var(--primary);
    }

    .card-image {
        position: relative;
        aspect-ratio: 16 / 10;
        overflow: hidden;
        border-bottom: 1px solid var(--border);
        background: var(--bg-sub);
    }

    .card-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .carousel-card:hover .card-image img {
        transform: scale(1.04);
    }

    .play-overlay {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 42px;
        height: 42px;
        background: color-mix(in srgb, var(--bg-main) 84%, transparent);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid var(--border-strong);
        box-shadow: var(--shadow-sm);
        transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .play-icon {
        width: 15px;
        height: 15px;
        color: var(--text-main);
        margin-left: 2px;
        transition: color 0.25s ease;
    }

    .carousel-card:hover .play-overlay {
        background: var(--primary);
        border-color: var(--primary);
        transform: translate(-50%, -50%) scale(1.08);
    }

    .carousel-card:hover .play-icon {
        color: oklch(15% 0.02 155);
    }

    :global([data-theme="light"]) .carousel-card:hover .play-icon {
        color: #ffffff;
    }

    .wave-badge {
        position: absolute;
        bottom: 8px;
        left: 10px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 3px 9px;
        border-radius: 99px;
        font-size: 0.68rem;
        font-weight: 700;
        background: color-mix(in srgb, var(--bg-main) 86%, transparent);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        color: var(--text-main);
        border: 1px solid var(--border);
    }

    .wave-bars {
        display: inline-flex;
        align-items: flex-end;
        gap: 2px;
        height: 10px;
    }

    .wave-bars i {
        width: 2px;
        background: var(--primary);
        border-radius: 2px;
        display: block;
    }

    .wave-bars i:nth-child(1) {
        height: 5px;
    }
    .wave-bars i:nth-child(2) {
        height: 10px;
    }
    .wave-bars i:nth-child(3) {
        height: 7px;
    }
    .wave-bars i:nth-child(4) {
        height: 4px;
    }

    .card-content {
        padding: 14px 16px;
        display: flex;
        flex-direction: column;
        gap: 10px;
        flex-grow: 1;
        justify-content: space-between;
    }

    .card-text-group {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .card-title {
        font-size: 1.05rem;
        font-weight: 700;
        margin: 0;
        color: var(--text-main);
        letter-spacing: -0.015em;
        line-height: 1.3;
        display: -webkit-box;
        -webkit-line-clamp: 1;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .card-sub {
        font-size: 0.8rem;
        color: var(--text-muted);
        margin: 0;
        line-height: 1.35;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .card-footer {
        display: flex;
        align-items: center;
        gap: 6px;
        font-weight: 650;
        color: var(--primary);
        font-size: 0.84rem;
    }

    .icon {
        transition: transform 0.2s ease;
    }

    .carousel-card:hover .icon {
        transform: translateX(3px);
    }

    .cta-wrapper {
        display: flex;
        justify-content: flex-start;
    }

    .cta-wrapper :global(.cta-link) {
        margin-top: 0;
        padding: 11px 24px;
        font-size: 0.95rem;
    }

    @media (max-width: 680px) {
        .section-title {
            font-size: clamp(1.65rem, 6vw, 2.2rem);
        }
        .carousel-card {
            flex: 0 0 232px;
        }
        .card-content {
            padding: 12px 14px;
        }
    }
</style>
