---
import SectionCTA from "../SectionCTA.astro";

const currentLang = Astro.currentLocale || "en";

const ui = {
    en: {
        badge: "4-in-1 On-Device Health Suite",
        titleTop: "Daily Trackers,",
        titleBottom: "In One Calm Space.",
        body: "Replace cluttered single-purpose apps. Log your cycle, fasting windows, water intake, and daily mood—stored 100% locally on your phone.",
        tools: [
            {
                id: "cycle",
                title: "Period & Cycle Diary",
                desc: "Log cycles, phases & symptoms privately.",
                metric: "Day 14",
                subMetric: "Cycle Phase • 100% Local",
                accent: "rose",
            },
            {
                id: "fast",
                title: "Intermittent Fasting",
                desc: "Clean 16:8 & custom fasting timers.",
                metric: "16:8",
                subMetric: "14h 20m Active Window",
                accent: "sage",
            },
            {
                id: "water",
                title: "Daily Hydration",
                desc: "Effortless water logging & quiet nudges.",
                metric: "2.0 L",
                subMetric: "8 / 8 Glasses Today",
                accent: "aqua",
            },
            {
                id: "mood",
                title: "Mood & Habit Rhythm",
                desc: "Mindful streaks & gratitude notes.",
                metric: "7 Days",
                subMetric: "Calm Daily Streak",
                accent: "amber",
            },
        ],
    },
    hi: {
        badge: "4-इन-1 ऑन-डिवाइस हेल्थ ट्रैकर्स",
        titleTop: "दैनिक सेहत ट्रैकर्स,",
        titleBottom: "एक ही शांत ऐप में।",
        body: "अलग-अलग ऐप्स की जगह एक ही शांत स्थान पर पीरियड डायरी, फास्टिंग टाइमर, वॉटर गोल और मूड ट्रैक करें — 100% आपके फोन में सुरक्षित।",
        tools: [
            {
                id: "cycle",
                title: "निजी पीरियड व साइकिल डायरी",
                desc: "मासिक चक्र और लक्षणों का लोकल रिकॉर्ड।",
                metric: "दिन 14",
                subMetric: "साइकिल फेज़ • 100% सुरक्षित",
                accent: "rose",
            },
            {
                id: "fast",
                title: "इंटरमिटेंट फास्टिंग टाइमर",
                desc: "16:8 उपवास और भोजन का सरल टाइमर।",
                metric: "16:8",
                subMetric: "14 घंटे 20 मिनट पूर्ण",
                accent: "sage",
            },
            {
                id: "water",
                title: "दैनिक वॉटर ट्रैकर",
                desc: "पर्याप्त पानी पीने की सहज आदत।",
                metric: "2.0 L",
                subMetric: "8 / 8 गिलास आज",
                accent: "aqua",
            },
            {
                id: "mood",
                title: "मूड और हैबिट रिदम",
                desc: "भावनाओं और स्वस्थ आदतों का जर्नल।",
                metric: "7 दिन",
                subMetric: "नियमित शांत अभ्यास",
                accent: "amber",
            },
        ],
    },
};

const t = ui[currentLang as keyof typeof ui] || ui.en;
---

<section id="wellness-suite" class="scroll-section section-tools">
    <div class="content-wrapper">
        <div class="container">
            <div class="section-header-left text-col animate-on-scroll">
                <span class="badge-small">{t.badge}</span>
                <h2 class="section-title">
                    {t.titleTop}{" "}
                    <span class="text-gradient">{t.titleBottom}</span>
                </h2>
                <p class="body-text">{t.body}</p>
            </div>
        </div>

        <div class="container bento-container animate-on-scroll delay-1">
            <div class="bento-grid">
                {
                    t.tools.map((tool) => (
                        <div
                            class:list={[
                                "bento-card premium-gloss-surface",
                                `accent-${tool.accent}`,
                            ]}
                        >
                            <div class="bento-top">
                                <div class="bento-icon-wrap" aria-hidden="true">
                                    {tool.id === "cycle" && (
                                        <svg
                                            viewBox="0 0 24 24"
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-width="2"
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                        >
                                            <circle
                                                cx="12"
                                                cy="12"
                                                r="9"
                                                stroke-dasharray="42 16"
                                            />
                                            <circle
                                                cx="12"
                                                cy="12"
                                                r="4"
                                                fill="currentColor"
                                                fill-opacity="0.2"
                                            />
                                        </svg>
                                    )}
                                    {tool.id === "fast" && (
                                        <svg
                                            viewBox="0 0 24 24"
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-width="2"
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                        >
                                            <circle cx="12" cy="13" r="8" />
                                            <path d="M12 9v4l2.5 2.5" />
                                            <path d="M9 3h6" />
                                        </svg>
                                    )}
                                    {tool.id === "water" && (
                                        <svg
                                            viewBox="0 0 24 24"
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-width="2"
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                        >
                                            <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z" />
                                        </svg>
                                    )}
                                    {tool.id === "mood" && (
                                        <svg
                                            viewBox="0 0 24 24"
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-width="2"
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                        >
                                            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
                                            <path d="M19 3v4" />
                                            <path d="M21 5h-4" />
                                        </svg>
                                    )}
                                </div>

                                <div class="bento-widget-pill">
                                    <strong class="widget-metric">
                                        {tool.metric}
                                    </strong>
                                    <span class="widget-sub">
                                        {tool.subMetric}
                                    </span>
                                </div>
                            </div>

                            <div class="bento-visual-bar" aria-hidden="true">
                                {tool.id === "cycle" && (
                                    <div class="mini-phase-track">
                                        <span class="phase-seg seg-1" />
                                        <span class="phase-seg seg-2 active" />
                                        <span class="phase-seg seg-3" />
                                        <span class="phase-seg seg-4" />
                                    </div>
                                )}
                                {tool.id === "fast" && (
                                    <div class="mini-progress-track">
                                        <div
                                            class="mini-progress-fill"
                                            style="width: 82%"
                                        />
                                    </div>
                                )}
                                {tool.id === "water" && (
                                    <div class="mini-bars-track">
                                        <span class="w-bar full" />
                                        <span class="w-bar full" />
                                        <span class="w-bar full" />
                                        <span class="w-bar full" />
                                        <span class="w-bar full" />
                                        <span class="w-bar full" />
                                        <span class="w-bar full" />
                                        <span class="w-bar full" />
                                    </div>
                                )}
                                {tool.id === "mood" && (
                                    <div class="mini-dots-track">
                                        <span class="s-dot done">✓</span>
                                        <span class="s-dot done">✓</span>
                                        <span class="s-dot done">✓</span>
                                        <span class="s-dot done">✓</span>
                                        <span class="s-dot done">✓</span>
                                        <span class="s-dot done">✓</span>
                                        <span class="s-dot done">✓</span>
                                    </div>
                                )}
                            </div>

                            <div class="bento-copy">
                                <h3 class="bento-title">{tool.title}</h3>
                                <p class="bento-desc">{tool.desc}</p>
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>

        <div class="container cta-wrapper animate-on-scroll delay-2">
            <SectionCTA
                href="/blog"
                labelEn="Read Wellness Articles"
                labelHi="वेलनेस ब्लॉग पढ़ें"
            />
        </div>
    </div>
</section>

<style>
    .section-tools {
        width: 100%;
    }

    .content-wrapper {
        display: flex;
        flex-direction: column;
        width: 100%;
        margin: 0 auto;
        gap: clamp(0.85rem, 2.2vh, 1.5rem);
    }

    .text-col {
        gap: 8px;
        width: 100%;
    }

    .section-title {
        font-size: clamp(1.9rem, 4.4vw, 3.2rem);
        letter-spacing: -0.03em;
        line-height: 1.12;
        color: var(--text-main);
    }

    .body-text {
        font-size: clamp(0.92rem, 1.6vw, 1.06rem);
        color: var(--text-muted);
        max-width: 58ch;
        line-height: 1.5;
    }

    .bento-container {
        width: 100%;
    }

    .bento-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 14px;
    }

    .bento-card {
        --tool-color: var(--primary);
        --tool-soft: var(--primary-soft);
        border-radius: var(--radius-lg);
        padding: clamp(1rem, 2vw, 1.4rem);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 12px;
        transition:
            transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
            border-color 0.25s ease;
    }

    .bento-card:hover {
        transform: translateY(-3px);
        border-color: var(--tool-color);
    }

    .bento-card.accent-rose {
        --tool-color: oklch(64% 0.14 22);
        --tool-soft: rgba(225, 110, 115, 0.14);
    }

    .bento-card.accent-sage {
        --tool-color: var(--primary);
        --tool-soft: var(--primary-soft);
    }

    .bento-card.accent-aqua {
        --tool-color: oklch(64% 0.11 215);
        --tool-soft: rgba(80, 175, 205, 0.15);
    }

    .bento-card.accent-amber {
        --tool-color: var(--accent-warm);
        --tool-soft: var(--accent-warm-soft);
    }

    .bento-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
    }

    .bento-icon-wrap {
        width: 40px;
        height: 40px;
        border-radius: 12px;
        background: var(--tool-soft);
        color: var(--tool-color);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border: 1px solid color-mix(in srgb, var(--tool-color) 25%, transparent);
    }

    .bento-icon-wrap svg {
        width: 20px;
        height: 20px;
    }

    .bento-widget-pill {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        text-align: right;
    }

    .widget-metric {
        font-size: 1.05rem;
        font-weight: 750;
        color: var(--tool-color);
        line-height: 1.15;
    }

    .widget-sub {
        font-size: 0.72rem;
        font-weight: 600;
        color: var(--text-muted);
    }

    .bento-visual-bar {
        width: 100%;
        padding: 4px 0;
    }

    .mini-phase-track {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 5px;
    }

    .phase-seg {
        height: 6px;
        border-radius: 99px;
        background: var(--bg-card-inner);
        border: 1px solid var(--border);
    }

    .phase-seg.active {
        background: var(--tool-color);
        border-color: var(--tool-color);
    }

    .mini-progress-track {
        width: 100%;
        height: 7px;
        border-radius: 99px;
        background: var(--bg-card-inner);
        overflow: hidden;
        border: 1px solid var(--border);
    }

    .mini-progress-fill {
        height: 100%;
        border-radius: 99px;
        background: var(--tool-color);
    }

    .mini-bars-track {
        display: grid;
        grid-template-columns: repeat(8, 1fr);
        gap: 5px;
    }

    .w-bar {
        height: 7px;
        border-radius: 99px;
        background: var(--tool-color);
        opacity: 0.85;
    }

    .mini-dots-track {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .s-dot {
        width: 20px;
        height: 20px;
        border-radius: 50%;
        background: var(--tool-soft);
        color: var(--tool-color);
        font-size: 0.65rem;
        font-weight: 800;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid color-mix(in srgb, var(--tool-color) 30%, transparent);
    }

    .bento-copy {
        display: flex;
        flex-direction: column;
        gap: 3px;
    }

    .bento-title {
        font-size: 1.05rem;
        font-weight: 700;
        color: var(--text-main);
        margin: 0;
        line-height: 1.25;
    }

    .bento-desc {
        font-size: 0.84rem;
        color: var(--text-muted);
        margin: 0;
        line-height: 1.38;
    }

    .cta-wrapper {
        display: flex;
        justify-content: flex-start;
    }

    .cta-wrapper :global(.cta-link) {
        margin-top: 0;
        padding: 11px 24px;
        font-size: 0.95rem;
    }

    @media (max-width: 680px) {
        .section-title {
            font-size: clamp(1.65rem, 6vw, 2.15rem);
        }

        .bento-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 10px;
        }

        .bento-card {
            padding: 12px;
            gap: 8px;
            border-radius: var(--radius-md);
        }

        .bento-icon-wrap {
            width: 32px;
            height: 32px;
            border-radius: 9px;
        }

        .bento-icon-wrap svg {
            width: 16px;
            height: 16px;
        }

        .widget-metric {
            font-size: 0.88rem;
        }

        .widget-sub {
            display: none;
        }

        .bento-title {
            font-size: 0.9rem;
        }

        .bento-desc {
            font-size: 0.75rem;
            line-height: 1.3;
        }

        .s-dot {
            width: 16px;
            height: 16px;
            font-size: 0.55rem;
        }
    }
</style>
