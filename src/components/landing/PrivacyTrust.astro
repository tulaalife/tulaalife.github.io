---
import SectionCTA from "../SectionCTA.astro";

const currentLang = Astro.currentLocale || "en";

const ui = {
    en: {
        badge: "No Sign-Up • No Phone Number",
        titleTop: "No Login, No Ads.",
        titleBottom: "100% On-Device.",
        desc: "Open Tulaa and start immediately. Your cycle logs, fasting windows, and mood notes never leave your phone.",
        pillars: [
            {
                id: "nosignup",
                tag: "01 • Instant Access",
                title: "No Sign-Up or OTP",
                desc: "Start practicing without sharing your email or phone number.",
            },
            {
                id: "vault",
                tag: "02 • Local Storage",
                title: "100% On-Device Vault",
                desc: "Encrypted locally on your phone. Export or wipe anytime.",
            },
            {
                id: "calm",
                tag: "03 • Pure Sanctuary",
                title: "Zero Ads & 30+ Themes",
                desc: "No pop-ups, no paywalls, and calming botanical palettes.",
            },
        ],
        reviewsLabel: "★★★★★ Loved on App Store & Google Play",
        reviews: [
            {
                text: "Finally a period tracker and gentle yoga app that never asks for my phone number or pushes paid plans.",
                author: "Ananya M.",
                source: "Google Play",
            },
            {
                text: "The bedtime meditations help me fall asleep within 5 minutes. Truly peaceful and distraction-free.",
                author: "Sneha R.",
                source: "Google Play",
            },
            {
                text: "So refreshing to open an app with zero ads and practice therapeutic yoga offline anytime.",
                author: "Prerna1407",
                source: "App Store",
            },
        ],
    },
    hi: {
        badge: "न कोई साइन-अप • न मोबाइल नंबर",
        titleTop: "कोई लॉगिन नहीं,",
        titleBottom: "100% फोन में सुरक्षित।",
        desc: "बिना मोबाइल नंबर या ईमेल डाले तुरंत योग और ध्यान शुरू करें। आपका डेटा कभी आपके फोन से बाहर नहीं जाता।",
        pillars: [
            {
                id: "nosignup",
                tag: "01 • तुरंत शुरुआत",
                title: "न साइन-अप, न OTP",
                desc: "बिना फोन नंबर या ईमेल के तुरंत अभ्यास शुरू करें।",
            },
            {
                id: "vault",
                tag: "02 • लोकल स्टोरेज",
                title: "100% ऑन-डिवाइस सुरक्षा",
                desc: "सारा हेल्थ डेटा केवल आपके फोन में सुरक्षित रहता है।",
            },
            {
                id: "calm",
                tag: "03 • शांत अनुभव",
                title: "बिना विज्ञापन व 30+ थीम्स",
                desc: "कोई पॉप-अप नहीं, कोई सब्सक्रिप्शन नहीं और सुंदर शांत रंग।",
            },
        ],
        reviewsLabel: "★★★★★ App Store और Play Store पर सराहा गया",
        reviews: [
            {
                text: "आख़िरकार एक ऐसा पीरियड ट्रैकर और योग ऐप मिला जो न फोन नंबर मांगता है और न कोई सब्सक्रिप्शन।",
                author: "अनन्या एम.",
                source: "Google Play",
            },
            {
                text: "सोने से पहले इसके मेडिटेशन सुनने से मुझे 5 मिनट में गहरी नींद आ जाती है। बहुत ही शांत ऐप।",
                author: "स्नेहा आर.",
                source: "Google Play",
            },
            {
                text: "बिना विज्ञापनों के कभी भी ऑफलाइन योग अभ्यास करने के लिए यह सबसे सरल और भरोसेमंद ऐप है।",
                author: "प्रेरणा1407",
                source: "App Store",
            },
        ],
    },
};

const t = ui[currentLang as keyof typeof ui] || ui.en;
---

<section id="privacy-trust" class="scroll-section section-privacy">
    <div class="content-wrapper">
        <div class="container">
            <div class="section-header-left header-content animate-on-scroll">
                <span class="badge-small">{t.badge}</span>
                <h2 class="section-title">
                    <span class="title-main">{t.titleTop}</span>{" "}
                    <span class="text-gradient">{t.titleBottom}</span>
                </h2>
                <p class="body-text">{t.desc}</p>
            </div>
        </div>

        <div class="container pillars-container animate-on-scroll delay-1">
            <div class="pillars-grid">
                {
                    t.pillars.map((pillar) => (
                        <div class="pillar-card premium-gloss-surface">
                            <div class="pillar-top">
                                <div class="pillar-icon" aria-hidden="true">
                                    {pillar.id === "nosignup" && (
                                        <svg
                                            viewBox="0 0 24 24"
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-width="2"
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                        >
                                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                                            <path d="m9 12 2 2 4-4" />
                                        </svg>
                                    )}
                                    {pillar.id === "vault" && (
                                        <svg
                                            viewBox="0 0 24 24"
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-width="2"
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                        >
                                            <rect
                                                width="18"
                                                height="11"
                                                x="3"
                                                y="11"
                                                rx="2"
                                                ry="2"
                                            />
                                            <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                                        </svg>
                                    )}
                                    {pillar.id === "calm" && (
                                        <svg
                                            viewBox="0 0 24 24"
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-width="2"
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                        >
                                            <circle cx="12" cy="12" r="10" />
                                            <path d="M8 14s1.5 2 4 2 4-2 4-2" />
                                            <line
                                                x1="9"
                                                x2="9.01"
                                                y1="9"
                                                y2="9"
                                            />
                                            <line
                                                x1="15"
                                                x2="15.01"
                                                y1="9"
                                                y2="9"
                                            />
                                        </svg>
                                    )}
                                </div>
                                <span class="pillar-tag">{pillar.tag}</span>
                            </div>
                            <div class="pillar-copy">
                                <h3 class="pillar-title">{pillar.title}</h3>
                                <p class="pillar-desc">{pillar.desc}</p>
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>

        <div class="container reviews-container animate-on-scroll delay-1">
            <span class="reviews-eyebrow">{t.reviewsLabel}</span>
            <div class="reviews-track">
                {
                    t.reviews.map((rev) => (
                        <blockquote class="review-card premium-gloss-surface">
                            <p class="review-text">“{rev.text}”</p>
                            <footer class="review-author">
                                <strong>{rev.author}</strong>
                                <span>· {rev.source}</span>
                            </footer>
                        </blockquote>
                    ))
                }
            </div>
        </div>

        <div class="container cta-wrapper animate-on-scroll delay-2">
            <SectionCTA
                href="/faq"
                labelEn="Frequently Asked Questions"
                labelHi="अक्सर पूछे जाने वाले प्रश्न"
            />
        </div>
    </div>
</section>

<style>
    .section-privacy {
        width: 100%;
    }

    .content-wrapper {
        display: flex;
        flex-direction: column;
        width: 100%;
        margin: 0 auto;
        gap: clamp(0.75rem, 2vh, 1.35rem);
    }

    .header-content {
        max-width: 740px;
        gap: 8px;
        width: 100%;
    }

    .section-title {
        font-size: clamp(1.9rem, 4.4vw, 3.2rem);
        letter-spacing: -0.03em;
        line-height: 1.12;
        color: var(--text-main);
    }

    .body-text {
        font-size: clamp(0.92rem, 1.6vw, 1.05rem);
        color: var(--text-muted);
        line-height: 1.5;
        max-width: 58ch;
    }

    .pillars-container {
        width: 100%;
    }

    .pillars-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 14px;
    }

    .pillar-card {
        border-radius: var(--radius-lg);
        padding: clamp(1rem, 1.8vw, 1.3rem);
        display: flex;
        flex-direction: column;
        gap: 10px;
        transition:
            transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
            border-color 0.25s ease;
    }

    .pillar-card:hover {
        transform: translateY(-3px);
        border-color: var(--primary);
    }

    .pillar-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
    }

    .pillar-icon {
        width: 38px;
        height: 38px;
        border-radius: 11px;
        background: var(--primary-soft);
        color: var(--primary);
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid color-mix(in srgb, var(--primary) 24%, transparent);
    }

    .pillar-icon svg {
        width: 19px;
        height: 19px;
    }

    .pillar-tag {
        font-size: 0.72rem;
        font-weight: 700;
        color: var(--primary);
        letter-spacing: 0.03em;
        text-transform: uppercase;
    }

    .pillar-copy {
        display: flex;
        flex-direction: column;
        gap: 3px;
    }

    .pillar-title {
        font-size: 1.02rem;
        font-weight: 700;
        color: var(--text-main);
        margin: 0;
        line-height: 1.25;
    }

    .pillar-desc {
        font-size: 0.82rem;
        color: var(--text-muted);
        margin: 0;
        line-height: 1.38;
    }

    .reviews-container {
        display: flex;
        flex-direction: column;
        gap: 8px;
        text-align: left;
    }

    .reviews-eyebrow {
        font-size: 0.76rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        color: var(--accent-warm);
        text-transform: uppercase;
    }

    .reviews-track {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 14px;
    }

    .review-card {
        margin: 0;
        padding: 14px 16px;
        border-radius: var(--radius-md);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 8px;
        background: var(--bg-card-inner);
    }

    .review-text {
        margin: 0;
        font-size: 0.84rem;
        line-height: 1.45;
        color: var(--text-main);
    }

    .review-author {
        font-size: 0.76rem;
        color: var(--text-muted);
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .review-author strong {
        color: var(--primary);
        font-weight: 700;
    }

    .cta-wrapper {
        display: flex;
        justify-content: flex-start;
    }

    .cta-wrapper :global(.cta-link) {
        margin-top: 0;
        padding: 11px 24px;
        font-size: 0.95rem;
    }

    @media (max-width: 768px) {
        .section-title {
            font-size: clamp(1.6rem, 6vw, 2.1rem);
        }

        .pillars-grid {
            grid-template-columns: 1fr;
            gap: 8px;
        }

        .pillar-card {
            flex-direction: row;
            align-items: center;
            padding: 10px 12px;
            gap: 12px;
            border-radius: var(--radius-md);
        }

        .pillar-top {
            flex-shrink: 0;
        }

        .pillar-tag {
            display: none;
        }

        .pillar-icon {
            width: 34px;
            height: 34px;
        }

        .pillar-title {
            font-size: 0.9rem;
        }

        .pillar-desc {
            font-size: 0.76rem;
            line-height: 1.3;
        }

        .reviews-track {
            display: flex;
            overflow-x: auto;
            scroll-snap-type: x mandatory;
            gap: 10px;
            padding-bottom: 4px;
            scrollbar-width: none;
            -webkit-overflow-scrolling: touch;
        }

        .reviews-track::-webkit-scrollbar {
            display: none;
        }

        .review-card {
            flex: 0 0 265px;
            scroll-snap-align: start;
            padding: 12px 14px;
        }

        .review-text {
            font-size: 0.8rem;
        }
    }
</style>
