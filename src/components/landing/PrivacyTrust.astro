---
const currentLang = Astro.currentLocale || "en";

const ui = {
    en: {
        titleTop: "No Login, No Ads.",
        titleBottom: "100% Private.",
        pillars: [
            {
                id: "nosignup",
                tag: "01",
                title: "No Sign-Up or OTP",
                desc: "Start immediately—no email or phone number needed.",
                tone: "sage",
            },
            {
                id: "vault",
                tag: "02",
                title: "Stays on Your Phone",
                desc: "All health logs stay local. Export or delete anytime.",
                tone: "warm",
            },
            {
                id: "calm",
                tag: "03",
                title: "Zero Ads & 30+ Themes",
                desc: "No pop-ups or distractions—just calm color themes.",
                tone: "sage",
            },
        ],
    },
    hi: {
        titleTop: "कोई लॉगिन नहीं,",
        titleBottom: "100% सुरक्षित।",
        pillars: [
            {
                id: "nosignup",
                tag: "01",
                title: "न साइन-अप, न OTP",
                desc: "बिना फोन नंबर या ईमेल डाले तुरंत शुरू करें।",
                tone: "sage",
            },
            {
                id: "vault",
                tag: "02",
                title: "डेटा सिर्फ़ आपके फोन में",
                desc: "आपका रिकॉर्ड फोन में ही रहता है, कभी शेयर नहीं होता।",
                tone: "warm",
            },
            {
                id: "calm",
                tag: "03",
                title: "बिना विज्ञापन व 30+ थीम्स",
                desc: "कोई पॉप-अप नहीं — बस शांत और आसान अनुभव।",
                tone: "sage",
            },
        ],
    },
};

const t = ui[currentLang as keyof typeof ui] || ui.en;
---

<section id="privacy-trust" class="scroll-section section-privacy">
    <div class="content-wrapper">
        <div class="container">
            <div class="section-header-left header-content animate-on-scroll">
                <h2 class="section-title">
                    <span class="title-main">{t.titleTop}</span>{" "}
                    <span class="text-gradient">{t.titleBottom}</span>
                </h2>
            </div>
        </div>

        <div class="container pillars-container animate-on-scroll delay-1">
            <div class="pillars-grid">
                {
                    t.pillars.map((pillar) => (
                        <div
                            class:list={[
                                "pillar-card premium-gloss-surface",
                                `tone-${pillar.tone}`,
                            ]}
                        >
                            <div class="pillar-top">
                                <div class="pillar-icon" aria-hidden="true">
                                    {pillar.id === "nosignup" && (
                                        <svg viewBox="0 0 28 28" fill="none">
                                            <path
                                                d="M14 25s9-4.5 9-11.5V6l-9-3.5L5 6v7.5C5 20.5 14 25 14 25z"
                                                fill="currentColor"
                                                fill-opacity="0.24"
                                                stroke="currentColor"
                                                stroke-width="2"
                                                stroke-linejoin="round"
                                            />
                                            <path
                                                d="m10.5 13.5 2.5 2.5 5-5"
                                                stroke="currentColor"
                                                stroke-width="2.1"
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                            />
                                        </svg>
                                    )}
                                    {pillar.id === "vault" && (
                                        <svg viewBox="0 0 28 28" fill="none">
                                            <rect
                                                width="18"
                                                height="12"
                                                x="5"
                                                y="12.5"
                                                rx="3"
                                                fill="currentColor"
                                                fill-opacity="0.25"
                                                stroke="currentColor"
                                                stroke-width="2"
                                            />
                                            <path
                                                d="M9 12.5V8.5a5 5 0 0 1 10 0v4"
                                                stroke="currentColor"
                                                stroke-width="2"
                                                stroke-linecap="round"
                                            />
                                            <circle
                                                cx="14"
                                                cy="18.5"
                                                r="1.8"
                                                fill="currentColor"
                                            />
                                        </svg>
                                    )}
                                    {pillar.id === "calm" && (
                                        <svg viewBox="0 0 28 28" fill="none">
                                            <path
                                                d="M14 5C17.2 10.5 17.2 16.5 14 22C10.8 16.5 10.8 10.5 14 5Z"
                                                fill="currentColor"
                                                fill-opacity="0.26"
                                                stroke="currentColor"
                                                stroke-width="1.9"
                                                stroke-linejoin="round"
                                            />
                                            <path
                                                d="M14 22C19 17.5 23 16.5 25 11.5C20 11 16.2 13.8 14 22Z"
                                                fill="currentColor"
                                                fill-opacity="0.16"
                                                stroke="currentColor"
                                                stroke-width="1.9"
                                                stroke-linejoin="round"
                                            />
                                            <path
                                                d="M14 22C9 17.5 5 16.5 3 11.5C8 11 11.8 13.8 14 22Z"
                                                fill="currentColor"
                                                fill-opacity="0.16"
                                                stroke="currentColor"
                                                stroke-width="1.9"
                                                stroke-linejoin="round"
                                            />
                                        </svg>
                                    )}
                                </div>
                                <span class="pillar-tag">{pillar.tag}</span>
                            </div>
                            <div class="pillar-copy">
                                <h3 class="pillar-title">{pillar.title}</h3>
                                <p class="pillar-desc">{pillar.desc}</p>
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </div>
</section>

<style>
    .section-privacy {
        width: 100%;
    }

    .content-wrapper {
        display: flex;
        flex-direction: column;
        width: 100%;
        margin: 0 auto;
        gap: clamp(1.1rem, 3vh, 2rem);
    }

    .header-content {
        max-width: 740px;
        gap: 8px;
        width: 100%;
    }

    .section-title {
        font-size: clamp(1.9rem, 4.4vw, 3.2rem);
        letter-spacing: -0.03em;
        line-height: 1.12;
        color: var(--text-main);
    }

    .body-text {
        font-size: clamp(0.92rem, 1.6vw, 1.05rem);
        color: var(--text-muted);
        line-height: 1.5;
        max-width: 58ch;
    }

    .pillars-container {
        width: 100%;
    }

    .pillars-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
    }

    .pillar-card {
        --pillar-color: var(--primary);
        --pillar-soft: var(--primary-soft);
        border-radius: var(--radius-lg);
        padding: clamp(1.25rem, 2.4vw, 1.85rem);
        display: flex;
        flex-direction: column;
        gap: 14px;
        transition:
            transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
            border-color 0.25s ease;
    }

    .pillar-card:hover {
        transform: translateY(-3px);
        border-color: var(--pillar-color);
    }

    .pillar-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
    }

    .pillar-icon {
        width: 46px;
        height: 46px;
        border-radius: 14px;
        background: var(--pillar-soft);
        color: var(--pillar-color);
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid color-mix(in srgb, var(--pillar-color) 28%, transparent);
    }

    .pillar-icon svg {
        width: 24px;
        height: 24px;
    }

    .pillar-tag {
        font-size: 0.74rem;
        font-weight: 700;
        color: var(--pillar-color);
        letter-spacing: 0.03em;
        text-transform: uppercase;
    }

    .pillar-copy {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .pillar-title {
        font-size: 1.12rem;
        font-weight: 700;
        color: var(--text-main);
        margin: 0;
        line-height: 1.25;
    }

    .pillar-desc {
        font-size: 0.9rem;
        color: var(--text-muted);
        margin: 0;
        line-height: 1.45;
    }

    @media (max-width: 768px) {
        .section-title {
            font-size: clamp(1.6rem, 6vw, 2.1rem);
        }

        .pillars-grid {
            grid-template-columns: minmax(0, 1fr);
            gap: 10px;
        }

        .pillar-card {
            flex-direction: row;
            align-items: center;
            padding: 14px 16px;
            gap: 14px;
            border-radius: var(--radius-md);
        }

        .pillar-top {
            flex-shrink: 0;
        }

        .pillar-tag {
            display: none;
        }

        .pillar-icon {
            width: 42px;
            height: 42px;
            border-radius: 12px;
        }

        .pillar-icon svg {
            width: 21px;
            height: 21px;
        }

        .pillar-title {
            font-size: 0.98rem;
        }

        .pillar-desc {
            font-size: 0.82rem;
            line-height: 1.38;
        }
    }
</style>
