---
import SectionCTA from "../SectionCTA.astro";
import AnimatedFeatureCard from "./AnimatedFeatureCard.astro";

const currentLang = Astro.currentLocale || "en";

const ui = {
    en: {
        badge: "No Sign-Up • No Phone Number",
        titleTop: "No Login, No Ads.",
        titleBottom: "100% On-Device.",
        descTop:
            "Open Tulaa and start immediately—without sharing your email or phone number.",
        descBottom: "Your cycle logs, fasting windows, and mood notes never leave your phone.",
        features: [
            {
                title: "No Sign-Up Required",
                desc: "Zero OTP prompts. Export or wipe your data anytime.",
                type: "privacy",
                color: "oklch(48% 0.085 156)",
            },
            {
                title: "Download Once, Practice Offline",
                desc: "Save routines locally and practice without internet.",
                type: "offline",
                color: "oklch(58% 0.11 65)",
            },
            {
                title: "30+ Serene Themes",
                desc: "Personalize fonts and calming palettes to match your mood.",
                type: "customize",
                color: "oklch(55% 0.1 25)",
            },
        ],
        reviewsLabel: "Loved for daily calm & privacy",
        reviews: [
            {
                text: "Finally a period tracker and gentle yoga app that does not ask for my phone number or push paid plans. Truly calming.",
                author: "Ananya M. · Play Store",
            },
            {
                text: "I love the app's meditations. I listen to them during bedtime, and they help me go to sleep within 5 minutes.",
                author: "Sneha R. · Play Store",
            },
            {
                text: "The app is very easy to use and it's great to have an app without ads and only peaceful yoga to practice anytime.",
                author: "Prerna1407 · App Store",
            },
        ],
    },
    hi: {
        badge: "न कोई साइन-अप • न मोबाइल नंबर",
        titleTop: "कोई लॉगिन नहीं,",
        titleBottom: "100% फोन में सुरक्षित।",
        descTop:
            "बिना मोबाइल नंबर या ईमेल डाले तुरंत योग और ध्यान शुरू करें।",
        descBottom: "आपका पीरियड लॉग, फास्टिंग टाइमर और मूड नोट्स कभी आपके फोन से बाहर नहीं जाते।",
        features: [
            {
                title: "न साइन-अप, न OTP",
                desc: "बिना फोन नंबर या ईमेल के तुरंत अभ्यास शुरू करें।",
                type: "privacy",
                color: "oklch(48% 0.085 156)",
            },
            {
                title: "एक बार डाउनलोड, ऑफलाइन अभ्यास",
                desc: "वीडियो फोन में सेव करें और बिना इंटरनेट अभ्यास करें।",
                type: "offline",
                color: "oklch(58% 0.11 65)",
            },
            {
                title: "30+ शांत और सुंदर थीम्स",
                desc: "अपनी पसंद के रंग और फॉन्ट चुनें।",
                type: "customize",
                color: "oklch(55% 0.1 25)",
            },
        ],
        reviewsLabel: "हमारे यूज़र्स को क्या पसंद है",
        reviews: [
            {
                text: "आख़िरकार एक ऐसा पीरियड ट्रैकर और योग ऐप मिला जो न फोन नंबर मांगता है और न कोई सब्सक्रिप्शन। बहुत ही शांत और भरोसेमंद।",
                author: "अनन्या एम · Play Store",
            },
            {
                text: "मुझे इस ऐप के मेडिटेशन बहुत पसंद हैं। मैं इन्हें सोने से पहले सुनती हूँ और ये मुझे 5 मिनट के अंदर सुला देते हैं।",
                author: "स्नेहा आर · Play Store",
            },
            {
                text: "यह ऐप इस्तेमाल करने में बहुत आसान है और बिना विज्ञापनों वाला ऐसा ऐप होना बहुत अच्छा है, जिसमें आप कभी भी शांति से योग कर सकते हैं।",
                author: "प्रेरणा1407 · App Store",
            },
        ],
    },
};

const t = ui[currentLang as keyof typeof ui] || ui.en;
---

<section class="scroll-section section-privacy">
    <div style="width: 100%;">
        <div class="container">
            <div class="section-header-left header-content animate-on-scroll">
                <span class="badge-small" style="margin-bottom: 12px;">{t.badge}</span>
                <h2 class="section-title">
                    <span class="title-main">{t.titleTop}</span><br />
                    <span class="text-gradient">{t.titleBottom}</span>
                </h2>
                <p class="body-text">
                    {t.descTop}<br class="hidden-mobile" />{t.descBottom}
                </p>
            </div>
        </div>

        <div class="container stack-stage-container animate-on-scroll delay-1">
            <div class="privacy-stage-frame" id="privacy-stage-frame">
                {
                    t.features.map((feature, index) => (
                        <AnimatedFeatureCard
                            title={feature.title}
                            desc={feature.desc}
                            color={feature.color}
                            type={feature.type}
                            index={index}
                            activeClass="active"
                        >
                            <Fragment slot="watermark">
                                {feature.type === "privacy" && (
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        width="32"
                                        height="32"
                                        fill="#000000"
                                        viewBox="0 0 256 256"
                                    >
                                        <path
                                            d="M216,96V208a8,8,0,0,1-8,8H48a8,8,0,0,1-8-8V96a8,8,0,0,1,8-8H208A8,8,0,0,1,216,96Z"
                                            opacity="0.2"
                                        />
                                        <path d="M208,80H176V56a48,48,0,0,0-96,0V80H48A16,16,0,0,0,32,96V208a16,16,0,0,0,16,16H208a16,16,0,0,0,16-16V96A16,16,0,0,0,208,80ZM96,56a32,32,0,0,1,64,0V80H96ZM208,208H48V96H208V208Zm-68-56a12,12,0,1,1-12-12A12,12,0,0,1,140,152Z" />
                                    </svg>
                                )}
                                {feature.type === "offline" && (
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        width="32"
                                        height="32"
                                        fill="#000000"
                                        viewBox="0 0 256 256"
                                    >
                                        <path
                                            d="M229.06,108.79l-48.7,42,14.88,62.79a8.4,8.4,0,0,1-12.52,9.17L128,189.09,73.28,222.74a8.4,8.4,0,0,1-12.52-9.17l14.88-62.79-48.7-42A8.46,8.46,0,0,1,31.73,94L95.64,88.8l24.62-59.6a8.36,8.36,0,0,1,15.48,0l24.62,59.6L224.27,94A8.46,8.46,0,0,1,229.06,108.79Z"
                                            opacity="0.2"
                                        />
                                        <path d="M239.18,97.26A16.38,16.38,0,0,0,224.92,86l-59-4.76L143.14,26.15a16.36,16.36,0,0,0-30.27,0L90.11,81.23,31.08,86a16.46,16.46,0,0,0-9.37,28.86l45,38.83L53,211.75a16.38,16.38,0,0,0,24.5,17.82L128,198.49l50.53,31.08A16.4,16.4,0,0,0,203,211.75l-13.76-58.07,45-38.83A16.43,16.43,0,0,0,239.18,97.26Zm-15.34,5.47-48.7,42a8,8,0,0,0-2.56,7.91l14.88,62.8a.37.37,0,0,1-.17.48c-.18.14-.23.11-.38,0l-54.72-33.65a8,8,0,0,0-8.38,0L69.09,215.94c-.15.09-.19.12-.38,0a.37.37,0,0,1-.17-.48l14.88-62.8a8,8,0,0,0-2.56-7.91l-48.7-42c-.12-.1-.23-.19-.13-.5s.18-.27.33-.29l63.92-5.16A8,8,0,0,0,103,91.86l24.62-59.61c.08-.17.11-.25.35-.25s.27.08.35.25L153,91.86a8,8,0,0,0,6.75,4.92l63.92,5.16c.15,0,.24,0,.33.29S224,102.63,223.84,102.73Z" />
                                    </svg>
                                )}
                                {feature.type === "customize" && (
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        width="32"
                                        height="32"
                                        fill="#000000"
                                        viewBox="0 0 256 256"
                                    >
                                        <path
                                            d="M176,112,74.34,213.66a8,8,0,0,1-11.31,0L42.34,193a8,8,0,0,1,0-11.31L144,80Z"
                                            opacity="0.2"
                                        />
                                        <path d="M248,152a8,8,0,0,1-8,8H224v16a8,8,0,0,1-16,0V160H192a8,8,0,0,1,0-16h16V128a8,8,0,0,1,16,0v16h16A8,8,0,0,1,248,152ZM56,72H72V88a8,8,0,0,0,16,0V72h16a8,8,0,0,0,0-16H88V40a8,8,0,0,0-16,0V56H56a8,8,0,0,0,0,16ZM184,192h-8v-8a8,8,0,0,0-16,0v8h-8a8,8,0,0,0,0,16h8v8a8,8,0,0,0,16,0v-8h8a8,8,0,0,0,0-16ZM219.31,80,80,219.31a16,16,0,0,1-22.62,0L36.68,198.63a16,16,0,0,1,0-22.63L176,36.69a16,16,0,0,1,22.63,0l20.68,20.68A16,16,0,0,1,219.31,80Zm-54.63,32L144,91.31l-96,96L68.68,208ZM208,68.69,187.31,48l-32,32L176,100.69Z" />
                                    </svg>
                                )}
                            </Fragment>
                        </AnimatedFeatureCard>
                    ))
                }
            </div>
        </div>

        <div class="container reviews-container animate-on-scroll delay-1">
            <span class="reviews-eyebrow">{t.reviewsLabel}</span>
            <div class="reviews-grid">
                {
                    t.reviews.map((rev) => (
                        <blockquote class="review-card premium-gloss-surface">
                            <p class="review-text">“{rev.text}”</p>
                            <footer class="review-author">— {rev.author}</footer>
                        </blockquote>
                    ))
                }
            </div>
        </div>

        <div class="container cta-wrapper animate-on-scroll delay-2">
            <SectionCTA
                href="/faq"
                labelEn="Frequently Asked Questions"
                labelHi="अक्सर पूछे जाने वाले प्रश्न"
            />
        </div>
    </div>
</section>

<script>
    document.addEventListener("astro:page-load", () => {
        const stage = document.getElementById("privacy-stage-frame");
        if (!stage) return;
        const cards = stage.querySelectorAll(".animated-feature-card");
        let activeIndex = 0;
        if (cards.length === 0) return;

        setInterval(() => {
            cards[activeIndex].classList.remove("active");
            activeIndex = (activeIndex + 1) % cards.length;
            cards[activeIndex].classList.add("active");
        }, 4500);
    });
</script>

<style>
    .section-privacy {
        width: 100%;
        display: flex;
        align-items: center;
        padding-top: var(--section-v-padding);
        padding-bottom: var(--section-v-padding);
    }
    .header-content {
        max-width: 720px;
        margin-bottom: var(--space-md);
        text-align: left;
        width: 100%;
    }
    .section-title {
        font-size: clamp(2.2rem, 5.5vw, 3.8rem);
        letter-spacing: -0.035em;
        line-height: 1.1;
        color: var(--text-main);
    }
    .body-text {
        font-size: clamp(1.05rem, 2vw, 1.2rem);
        color: var(--text-muted);
        line-height: 1.6;
        max-width: 54ch;
        margin-top: var(--space-xs);
    }
    .stack-stage-container {
        width: 100%;
        margin-bottom: var(--space-lg);
    }
    .privacy-stage-frame {
        position: relative;
        width: 100%;
        max-width: 480px;
        height: 114px;
        display: grid;
        grid-template-columns: 1fr;
    }
    .cta-wrapper {
        display: flex;
        justify-content: flex-start;
    }
    .reviews-container {
        margin-bottom: var(--space-md);
        display: flex;
        flex-direction: column;
        gap: 12px;
        text-align: left;
    }
    .reviews-eyebrow {
        font-size: 0.78rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--text-muted);
    }
    .reviews-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 16px;
    }
    .review-card {
        margin: 0;
        padding: 20px 22px;
        border-radius: var(--radius-md);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 12px;
    }
    .review-text {
        margin: 0;
        font-size: 0.94rem;
        line-height: 1.55;
        color: var(--text-main);
    }
    .review-author {
        font-size: 0.8rem;
        font-weight: 600;
        color: var(--primary);
    }
    .hidden-mobile {
        display: inline;
    }
    :lang(hi) .section-title {
        line-height: 1.35;
    }

    @media (max-height: 740px) {
        .body-text {
            display: none;
        }
        .privacy-stage-frame {
            height: 96px;
        }
    }
    @media (max-width: 768px) {
        .hidden-mobile {
            display: none;
        }
        .privacy-stage-frame {
            max-width: 100%;
        }
    }
</style>
