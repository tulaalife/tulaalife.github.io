---
import StoreButtons from "../StoreButtons.astro";
import { yogaPlans, manualRecommendations } from "../../data/generated";
import { PLAN_FINDER_BRANCHES } from "../../utils/ui-strings";

const currentLang = (Astro.currentLocale || "en") as "en" | "hi";

const ui = {
    en: {
        badge: "NO LOGIN • NO ADS • 100% ON-DEVICE PRIVACY",
        step1TitleTop: "How does your body",
        step1TitleBottom: "feel today?",
        step1Sub: "Select your primary need for a science-backed therapeutic yoga plan.",
        step3TitleTop: "Your Therapeutic",
        step3TitleBottom: "Yoga Plan is Ready.",
        step3Highlights: [
            "No Sign-Up or Phone Number Needed",
            "Download Once, Practice Offline",
            "100% Free & Ad-Free Sanctuary",
        ],
        backToStep1: "← Change focus area",
        backToStep2: "← Choose a different symptom",
        startOver: "Start over",
        matchBadge: "Recommended Plan",
        altHeader: "Also recommended:",
        viewDetails: "Read full plan guide →",
        appPrompt: "Open in Tulaa—no phone number, email, or login required:",
        browseAll: "Explore all 30+ therapeutic yoga plans →",
        authorName: "Curated by Latika Bissa",
        authorCreds: "Gold Medalist, M.Sc. Yoga Therapy • 12+ Yrs Clinical Exp",
        authorStats: "★ 5.0 Rated • 5,000+ Lives Transformed • 50L+ Views",
        authorSiteLabel: "yogawithlatika.com",
        intensityMap: {
            beginner: "Beginner Safe",
            intermediate: "Intermediate",
            advanced: "Advanced",
        } as Record<string, string>,
        freqMap: {
            daily: "Daily Practice",
            weekly_3_5: "3–5x / Week",
            weekly_1_2: "1–2x / Week",
            as_needed: "As Needed",
        } as Record<string, string>,
    },
    hi: {
        badge: "बिना लॉगिन • बिना विज्ञापन • 100% फोन में सुरक्षित",
        step1TitleTop: "आज आपका शरीर",
        step1TitleBottom: "कैसा महसूस कर रहा है?",
        step1Sub: "अपने लिए सही और वैज्ञानिक योग थेरेपी प्लान जानने के लिए अपनी मुख्य ज़रूरत चुनें।",
        step3TitleTop: "आपके लिए सुझाया गया",
        step3TitleBottom: "योग थेरेपी प्लान।",
        step3Highlights: [
            "न कोई साइन-अप, न मोबाइल नंबर",
            "एक बार डाउनलोड, ऑफलाइन अभ्यास",
            "100% फ्री और विज्ञापन-मुक्त",
        ],
        backToStep1: "← मुख्य श्रेणी बदलें",
        backToStep2: "← दूसरा विकल्प चुनें",
        startOver: "फिर से शुरू करें",
        matchBadge: "सर्वश्रेष्ठ सुझाव",
        altHeader: "अन्य उपयोगी प्लान:",
        viewDetails: "प्लान की पूरी जानकारी पढ़ें →",
        appPrompt: "बिना मोबाइल नंबर या लॉगिन के Tulaa ऐप में अभ्यास शुरू करें:",
        browseAll: "सभी 30+ योग थेरेपी प्लान्स देखें →",
        authorName: "लतिका बिस्सा द्वारा तैयार",
        authorCreds: "स्वर्ण पदक विजेता, M.Sc. योग थेरेपी • 12+ वर्षों का अनुभव",
        authorStats: "★ 5.0 रेटिंग • 5,000+ स्वस्थ जीवन • 50 लाख+ व्यूज़",
        authorSiteLabel: "yogawithlatika.com",
        intensityMap: {
            beginner: "शुरुआती (Beginner Safe)",
            intermediate: "मध्यम (Intermediate)",
            advanced: "उन्नत (Advanced)",
        } as Record<string, string>,
        freqMap: {
            daily: "प्रतिदिन अभ्यास",
            weekly_3_5: "सप्ताह में 3–5 बार",
            weekly_1_2: "सप्ताह में 1–2 बार",
            as_needed: "आवश्यकतानुसार",
        } as Record<string, string>,
    },
};

const t = ui[currentLang] || ui.en;
const basePlanHref = currentLang === "hi" ? "/hi/yoga" : "/yoga";

const localizedPlans = yogaPlans.filter((p) => p.language === currentLang);
const englishPlans = yogaPlans.filter((p) => p.language === "en");

const planById: Record<string, (typeof yogaPlans)[number]> = {};
englishPlans.forEach((p) => {
    if (p.id) planById[p.id] = p;
});
localizedPlans.forEach((p) => {
    if (p.id) planById[p.id] = p;
});

const clientPlansMap: Record<
    string,
    {
        id: string;
        slug: string;
        title: string;
        subtitle: string;
        benefits: string[];
        image: string;
        intensity: string;
        frequency: string;
        href: string;
    }
> = {};

Object.values(planById).forEach((p) => {
    const benefitsArr = p.benefits
        ? p.benefits
              .split(/\s*[·\n]\s*/)
              .map((b) => b.trim())
              .filter(Boolean)
              .slice(0, 3)
        : [];
    clientPlansMap[p.id] = {
        id: p.id,
        slug: p.slug,
        title: p.title,
        subtitle: p.subtitle,
        benefits: benefitsArr,
        image: p.image,
        intensity: p.intensity ? t.intensityMap[p.intensity] || p.intensity : t.intensityMap.beginner,
        frequency: p.practiceFrequency ? t.freqMap[p.practiceFrequency] || p.practiceFrequency : t.freqMap.daily,
        href: `${basePlanHref}/${p.slug}`,
    };
});

const overrides = manualRecommendations.overrides;
const defaultBranch = PLAN_FINDER_BRANCHES[0];
const defaultOptionKey = defaultBranch.options[0].key;
const defaultPlanIds = overrides[defaultOptionKey] || [];
const initialPrimary = defaultPlanIds[0] ? clientPlansMap[defaultPlanIds[0]] : Object.values(clientPlansMap)[0];
const initialAlts = defaultPlanIds
    .slice(1)
    .map((id) => clientPlansMap[id])
    .filter(Boolean);
---

<section id="hero" class="scroll-section hero-conversational">
    <div class="ambient-orb orb-1" aria-hidden="true"></div>
    <div class="ambient-orb orb-2" aria-hidden="true"></div>

    <div class="container hero-centered-shell">
        <div class="hero-intro">
            <span class="badge-small">{t.badge}</span>
            <h1 class="hero-title" lang={currentLang} id="dynamic-hero-title">
                <span id="hero-title-top">{t.step1TitleTop}</span>{" "}
                <span class="text-gradient" id="hero-title-bottom">{t.step1TitleBottom}</span>
            </h1>
            <p class="hero-sub body-text" id="hero-step1-sub">{t.step1Sub}</p>
        </div>

        <div
            class="dialogue-card premium-gloss-surface"
            id="plan-finder-app"
            data-overrides={JSON.stringify(overrides)}
            data-plans={JSON.stringify(clientPlansMap)}
            data-branches={JSON.stringify(PLAN_FINDER_BRANCHES)}
            data-lang={currentLang}
            data-step1-top={t.step1TitleTop}
            data-step1-bottom={t.step1TitleBottom}
            data-step3-top={t.step3TitleTop}
            data-step3-bottom={t.step3TitleBottom}
            data-step3-highlights={JSON.stringify(t.step3Highlights)}
        >
            <div class="step-dots" aria-hidden="true">
                <span class="step-dot active" data-dot="1"></span>
                <span class="step-dot" data-dot="2"></span>
                <span class="step-dot" data-dot="3"></span>
            </div>

            <!-- STEP 1: Pick 1 of 5 Branches -->
            <div class="wizard-step active" id="wizard-step-1">
                <div class="branch-grid">
                    {
                        PLAN_FINDER_BRANCHES.map((branch) => (
                            <button
                                type="button"
                                class="branch-choice"
                                data-branch-id={branch.id}
                            >
                                <div class="branch-choice-text">
                                    <strong class="branch-title">
                                        {currentLang === "hi" ? branch.hiLabel : branch.enLabel}
                                    </strong>
                                    <span class="branch-desc">
                                        {currentLang === "hi" ? branch.hiSub : branch.enSub}
                                    </span>
                                </div>
                                <span class="branch-arrow" aria-hidden="true">→</span>
                            </button>
                        ))
                    }
                </div>
            </div>

            <!-- STEP 2: Pick specific area / condition -->
            <div class="wizard-step" id="wizard-step-2" hidden>
                <div class="step-topbar">
                    <button type="button" class="back-step-btn" id="back-to-step-1">
                        {t.backToStep1}
                    </button>
                </div>
                <div class="sub-pills-wrap" id="finder-sub-options">
                    {
                        defaultBranch.options.map((opt) => (
                            <button
                                type="button"
                                class="sub-choice-pill"
                                data-override-key={opt.key}
                            >
                                {currentLang === "hi" ? opt.hi : opt.en}
                            </button>
                        ))
                    }
                </div>
            </div>

            <!-- STEP 3: Personalized Result Card -->
            {
                initialPrimary && (
                    <div class="wizard-step" id="wizard-step-3" hidden>
                        <div class="step-topbar">
                            <button type="button" class="back-step-btn" id="back-to-step-2">
                                {t.backToStep2}
                            </button>
                            <button type="button" class="reset-step-btn" id="reset-wizard">
                                {t.startOver}
                            </button>
                        </div>

                        <div class="result-spotlight">
                            <a href={initialPrimary.href} id="rec-img-link" class="result-visual">
                                <img
                                    id="rec-img"
                                    src={initialPrimary.image}
                                    alt={initialPrimary.title}
                                    width="600"
                                    height="380"
                                    loading="eager"
                                />
                                <span class="match-tag">{t.matchBadge}</span>
                            </a>

                            <div class="result-info">
                                <div class="result-meta">
                                    <span id="rec-intensity">{initialPrimary.intensity}</span>
                                    <span>•</span>
                                    <span id="rec-frequency">{initialPrimary.frequency}</span>
                                </div>

                                <h2 class="result-title">
                                    <a href={initialPrimary.href} id="rec-title-link">
                                        {initialPrimary.title}
                                    </a>
                                </h2>

                                <p class="result-subtitle" id="rec-subtitle">
                                    {initialPrimary.subtitle}
                                </p>

                                <ul class="result-highlights" id="rec-benefits">
                                    {initialPrimary.benefits.map((b) => (
                                        <li>{b}</li>
                                    ))}
                                </ul>

                                <div class="result-download-box">
                                    <span class="download-label">{t.appPrompt}</span>
                                    <StoreButtons />
                                    <a href={initialPrimary.href} id="rec-detail-link" class="plan-guide-link">
                                        {t.viewDetails}
                                    </a>
                                </div>
                            </div>
                        </div>

                        <div
                            class="alt-suggestions"
                            id="rec-alt-section"
                            style={initialAlts.length === 0 ? "display: none;" : ""}
                        >
                            <span class="alt-label">{t.altHeader}</span>
                            <div class="alt-pills" id="rec-alt-list">
                                {initialAlts.map((alt) => (
                                    <a href={alt.href} class="alt-link-pill">
                                        {alt.title} →
                                    </a>
                                ))}
                            </div>
                        </div>
                    </div>
                )
            }
        </div>

        <!-- Contextual Trust Slot Below Card: Latika Bio on Step 1, High-CVR App Highlights on Step 2 & 3 -->
        <div class="context-trust-slot">
            <div class="latika-bio-card premium-gloss-surface" id="hero-latika-bio">
                <div class="latika-avatar-wrap">
                    <img
                        src="/images/latika.png"
                        alt="Latika Bissa"
                        width="56"
                        height="56"
                        loading="eager"
                    />
                </div>
                <div class="latika-bio-content">
                    <div class="latika-bio-top">
                        <strong class="latika-bio-name">{t.authorName}</strong>
                        <a
                            href="https://yogawithlatika.com"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="latika-site-link"
                        >
                            {t.authorSiteLabel} ↗
                        </a>
                    </div>
                    <p class="latika-bio-creds">{t.authorCreds}</p>
                    <p class="latika-bio-stats">{t.authorStats}</p>
                </div>
            </div>

            <div class="conversion-highlights-bar" id="hero-conversion-highlights" hidden>
                <div class="highlights-pills" id="dynamic-highlights-list"></div>
            </div>
        </div>

        <div class="hero-footer-links">
            <a href={basePlanHref} class="explore-all-link">{t.browseAll}</a>
        </div>
    </div>
</section>

<script>
    document.addEventListener("astro:page-load", () => {
        const root = document.getElementById("plan-finder-app");
        if (!root) return;

        const overrides = JSON.parse(root.getAttribute("data-overrides") || "{}");
        const plans = JSON.parse(root.getAttribute("data-plans") || "{}");
        const branches = JSON.parse(root.getAttribute("data-branches") || "[]");
        const lang = root.getAttribute("data-lang") || "en";

        const step1Top = root.getAttribute("data-step1-top") || "";
        const step1Bottom = root.getAttribute("data-step1-bottom") || "";
        const step3Top = root.getAttribute("data-step3-top") || "";
        const step3Bottom = root.getAttribute("data-step3-bottom") || "";
        const step3Highlights: string[] = JSON.parse(
            root.getAttribute("data-step3-highlights") || "[]",
        );

        const titleTopEl = document.getElementById("hero-title-top");
        const titleBottomEl = document.getElementById("hero-title-bottom");
        const step1SubEl = document.getElementById("hero-step1-sub");
        const latikaBioEl = document.getElementById("hero-latika-bio");
        const highlightsWrapEl = document.getElementById("hero-conversion-highlights");
        const highlightsListEl = document.getElementById("dynamic-highlights-list");

        const step1 = document.getElementById("wizard-step-1");
        const step2 = document.getElementById("wizard-step-2");
        const step3 = document.getElementById("wizard-step-3");
        const dots = root.querySelectorAll(".step-dot");

        const subOptionsContainer = document.getElementById("finder-sub-options");

        const recImg = document.getElementById("rec-img") as HTMLImageElement | null;
        const recImgLink = document.getElementById("rec-img-link") as HTMLAnchorElement | null;
        const recTitleLink = document.getElementById("rec-title-link") as HTMLAnchorElement | null;
        const recSubtitle = document.getElementById("rec-subtitle");
        const recIntensity = document.getElementById("rec-intensity");
        const recFrequency = document.getElementById("rec-frequency");
        const recBenefits = document.getElementById("rec-benefits");
        const recDetailLink = document.getElementById("rec-detail-link") as HTMLAnchorElement | null;
        const recAltSection = document.getElementById("rec-alt-section");
        const recAltList = document.getElementById("rec-alt-list");

        let currentBranch: any = branches[0];
        let activeBranchHasSingleOption = false;

        function renderHighlightsPills(items: string[]) {
            if (!highlightsListEl) return;
            highlightsListEl.innerHTML = "";
            items.forEach((txt) => {
                const span = document.createElement("span");
                span.className = "cvr-highlight-pill";
                span.textContent = `✓ ${txt}`;
                highlightsListEl.appendChild(span);
            });
        }

        function setStep(stepNumber: 1 | 2 | 3) {
            [step1, step2, step3].forEach((el, idx) => {
                if (!el) return;
                const isCurrent = idx + 1 === stepNumber;
                el.hidden = !isCurrent;
                el.classList.toggle("active", isCurrent);
            });
            dots.forEach((dot, idx) => {
                dot.classList.toggle("active", idx + 1 <= stepNumber);
            });

            if (stepNumber === 1) {
                if (titleTopEl) titleTopEl.textContent = step1Top;
                if (titleBottomEl) titleBottomEl.textContent = step1Bottom;
                if (step1SubEl) step1SubEl.hidden = false;
                if (latikaBioEl) latikaBioEl.hidden = false;
                if (highlightsWrapEl) highlightsWrapEl.hidden = true;
            } else if (stepNumber === 2 && currentBranch) {
                if (titleTopEl) {
                    titleTopEl.textContent =
                        lang === "hi" ? currentBranch.hiTitleTop : currentBranch.enTitleTop;
                }
                if (titleBottomEl) {
                    titleBottomEl.textContent =
                        lang === "hi" ? currentBranch.hiTitleBottom : currentBranch.enTitleBottom;
                }
                if (step1SubEl) step1SubEl.hidden = true;
                if (latikaBioEl) latikaBioEl.hidden = true;
                if (highlightsWrapEl) {
                    highlightsWrapEl.hidden = false;
                    const branchHighlights =
                        lang === "hi" ? currentBranch.hiHighlights : currentBranch.enHighlights;
                    renderHighlightsPills(branchHighlights || step3Highlights);
                }
            } else if (stepNumber === 3) {
                if (titleTopEl) titleTopEl.textContent = step3Top;
                if (titleBottomEl) titleBottomEl.textContent = step3Bottom;
                if (step1SubEl) step1SubEl.hidden = true;
                if (latikaBioEl) latikaBioEl.hidden = true;
                if (highlightsWrapEl) {
                    highlightsWrapEl.hidden = false;
                    renderHighlightsPills(step3Highlights);
                }
            }
        }

        function renderRecommendation(overrideKey: string) {
            const planIds: string[] = overrides[overrideKey] || [];
            const matchedPlans = planIds.map((id) => plans[id]).filter(Boolean);
            if (matchedPlans.length === 0) return;

            const primary = matchedPlans[0];
            const alts = matchedPlans.slice(1);

            if (recImg) {
                recImg.src = primary.image;
                recImg.alt = primary.title;
            }
            if (recImgLink) recImgLink.href = primary.href;
            if (recTitleLink) {
                recTitleLink.textContent = primary.title;
                recTitleLink.href = primary.href;
            }
            if (recSubtitle) recSubtitle.textContent = primary.subtitle;
            if (recIntensity) recIntensity.textContent = primary.intensity;
            if (recFrequency) recFrequency.textContent = primary.frequency;
            if (recDetailLink) recDetailLink.href = primary.href;

            if (recBenefits) {
                recBenefits.innerHTML = "";
                (primary.benefits || []).forEach((b: string) => {
                    const li = document.createElement("li");
                    li.textContent = b;
                    recBenefits.appendChild(li);
                });
            }

            if (recAltSection && recAltList) {
                if (alts.length === 0) {
                    recAltSection.style.display = "none";
                } else {
                    recAltSection.style.display = "flex";
                    recAltList.innerHTML = "";
                    alts.forEach((alt) => {
                        const a = document.createElement("a");
                        a.href = alt.href;
                        a.className = "alt-link-pill";
                        a.textContent = `${alt.title} →`;
                        recAltList.appendChild(a);
                    });
                }
            }

            setStep(3);
        }

        function attachSubChipListeners() {
            if (!subOptionsContainer) return;
            const chips = subOptionsContainer.querySelectorAll(".sub-choice-pill");
            chips.forEach((chip) => {
                chip.addEventListener("click", () => {
                    const key = chip.getAttribute("data-override-key");
                    if (key) renderRecommendation(key);
                });
            });
        }

        root.querySelectorAll(".branch-choice").forEach((btn) => {
            btn.addEventListener("click", () => {
                const branchId = btn.getAttribute("data-branch-id");
                const branch = branches.find((b: any) => b.id === branchId);
                if (!branch || !subOptionsContainer) return;

                currentBranch = branch;
                activeBranchHasSingleOption = branch.options.length === 1;

                if (activeBranchHasSingleOption && branch.options[0]) {
                    renderRecommendation(branch.options[0].key);
                    return;
                }

                subOptionsContainer.innerHTML = "";
                branch.options.forEach((opt: any) => {
                    const pill = document.createElement("button");
                    pill.type = "button";
                    pill.className = "sub-choice-pill";
                    pill.setAttribute("data-override-key", opt.key);
                    pill.textContent = lang === "hi" ? opt.hi : opt.en;
                    subOptionsContainer.appendChild(pill);
                });

                attachSubChipListeners();
                setStep(2);
            });
        });

        document.getElementById("back-to-step-1")?.addEventListener("click", () => {
            setStep(1);
        });

        document.getElementById("back-to-step-2")?.addEventListener("click", () => {
            if (activeBranchHasSingleOption) {
                setStep(1);
            } else {
                setStep(2);
            }
        });

        document.getElementById("reset-wizard")?.addEventListener("click", () => {
            setStep(1);
        });

        attachSubChipListeners();
    });
</script>

<style>
    .hero-conversational {
        position: relative;
        overflow: hidden;
        padding-top: clamp(1.25rem, 3.5vh, 2.75rem);
        padding-bottom: clamp(1.75rem, 5vh, 3.5rem);
    }

    .ambient-orb {
        position: absolute;
        border-radius: 50%;
        filter: blur(72px);
        pointer-events: none;
        z-index: 0;
    }

    .orb-1 {
        width: 420px;
        height: 420px;
        top: -120px;
        left: 5%;
        background: var(--ambient-glow-1);
    }

    .orb-2 {
        width: 380px;
        height: 380px;
        bottom: -100px;
        right: 5%;
        background: var(--ambient-glow-2);
    }

    .hero-centered-shell {
        position: relative;
        z-index: 2;
        max-width: 780px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: clamp(1rem, 2.2vh, 1.5rem);
    }

    .hero-intro {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
        max-width: 650px;
    }

    .hero-title {
        font-size: clamp(1.85rem, 4.8vw, 3.35rem);
        line-height: 1.12;
        letter-spacing: -0.03em;
    }

    .hero-sub {
        font-size: clamp(0.95rem, 1.7vw, 1.1rem);
        color: var(--text-muted);
        line-height: 1.5;
    }

    .hero-sub[hidden] {
        display: none !important;
    }

    .dialogue-card {
        width: 100%;
        border-radius: var(--radius-lg);
        padding: clamp(1.15rem, 3vw, 2rem);
        display: flex;
        flex-direction: column;
        gap: 16px;
        text-align: left;
    }

    .step-dots {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

    .step-dot {
        width: 22px;
        height: 4px;
        border-radius: 99px;
        background: var(--border);
        transition: all 0.3s ease;
    }

    .step-dot.active {
        background: var(--primary);
        width: 34px;
    }

    .wizard-step {
        display: flex;
        flex-direction: column;
        gap: 14px;
        animation: fadeSlideIn 0.28s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .wizard-step[hidden] {
        display: none !important;
    }

    @keyframes fadeSlideIn {
        from {
            opacity: 0;
            transform: translateY(6px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .branch-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 10px;
    }

    .branch-choice {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 15px 18px;
        border-radius: var(--radius-md);
        background: var(--bg-main);
        border: 1px solid var(--border);
        cursor: pointer;
