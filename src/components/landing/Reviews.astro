const t = ui[currentLang as keyof typeof ui] || ui.en;
---

<section id="community-love" class="scroll-section section-reviews">
    <div class="content-wrapper">
        <div class="container">
            <div class="section-header-left header-content animate-on-scroll">
                <span class="badge-small">{t.badge}</span>
                <h2 class="section-title">
                    <span class="title-main">{t.titleTop}</span>{" "}
                    <span class="text-gradient">{t.titleBottom}</span>
                </h2>
            </div>
        </div>

        <div
            class="container reviews-container animate-on-scroll delay-1"
            id="reviews-showcase"
            data-reviews={JSON.stringify(t.reviews)}
        >
            <div class="reviews-grid" id="reviews-grid">
                {t.reviews.slice(0, 3).map((rev) => (
                    <blockquote class="review-card premium-gloss-surface">
                        <div class="review-card-top">
                            <div class="stars-row" aria-hidden="true">
                                {[1, 2, 3, 4, 5].map(() => (
                                    <svg
                                        viewBox="0 0 20 20"
                                        width="14"
                                        height="14"
                                        fill="currentColor"
                                    >
                                        <polygon points="10 1.5 12.6 6.8 18.5 7.6 14.2 11.8 15.2 17.6 10 14.8 4.8 17.6 5.8 11.8 1.5 7.6 7.4 6.8 10 1.5" />
                                    </svg>
                                ))}
                            </div>
                            <span class="review-highlight-pill">
                                {rev.highlight}
                            </span>
                        </div>

                        <p class="review-text">“{rev.text}”</p>

                        <footer class="review-author">
                            <div class="author-initial" aria-hidden="true">
                                {rev.author.charAt(0)}
                            </div>
                            <div class="author-meta">
                                <strong>{rev.author}</strong>
                                <span>{rev.source}</span>
                            </div>
                        </footer>
                    </blockquote>
                ))}
            </div>

            <div
                class="reviews-dots"
                id="reviews-dots"
                aria-label="Review pages"
            ></div>
        </div>
    </div>
</section>

<script>
    document.addEventListener("astro:page-load", () => {
        const container = document.getElementById("reviews-showcase");
        const grid = document.getElementById("reviews-grid");
        const dotsWrap = document.getElementById("reviews-dots");
        if (!container || !grid || !dotsWrap) return;

        const raw = container.getAttribute("data-reviews");
        if (!raw) return;

        const allReviews: Array<{
            highlight: string;
            text: string;
            author: string;
            source: string;
        }> = JSON.parse(raw);

        // Fisher-Yates shuffle for random order on every visit
        for (let i = allReviews.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [allReviews[i], allReviews[j]] = [allReviews[j], allReviews[i]];
        }

        const getBatchSize = () => (window.innerWidth <= 820 ? 2 : 3);
        let batchSize = getBatchSize();
        let totalPages = Math.ceil(allReviews.length / batchSize);
        let currentPage = 0;
        let isPaused = false;
        let timerId: ReturnType<typeof setInterval> | null = null;

        const starSvg = `<svg viewBox="0 0 20 20" width="14" height="14" fill="currentColor"><polygon points="10 1.5 12.6 6.8 18.5 7.6 14.2 11.8 15.2 17.6 10 14.8 4.8 17.6 5.8 11.8 1.5 7.6 7.4 6.8 10 1.5" /></svg>`;

        function renderDots() {
            if (!dotsWrap) return;
            dotsWrap.innerHTML = "";
            for (let p = 0; p < totalPages; p++) {
                const btn = document.createElement("button");
                btn.type = "button";
                btn.className = `rev-dot${p === currentPage ? " active" : ""}`;
                btn.setAttribute("aria-label", `Reviews group ${p + 1}`);
                btn.addEventListener("click", () => {
                    currentPage = p;
                    renderPage();
                });
                dotsWrap.appendChild(btn);
            }
        }

        function renderPage(animate = true) {
            if (!grid) return;
            const start = currentPage * batchSize;
            const slice = [];
            for (let i = 0; i < batchSize; i++) {
                slice.push(allReviews[(start + i) % allReviews.length]);
            }

            const updateDom = () => {
                grid.innerHTML = slice
                    .map(
                        (rev, idx) => `
                    <blockquote class="review-card premium-gloss-surface review-enter" style="animation-delay: ${idx * 75}ms">
                        <div class="review-card-top">
                            <div class="stars-row" aria-hidden="true">${starSvg.repeat(5)}</div>
                            <span class="review-highlight-pill">${rev.highlight}</span>
                        </div>
                        <p class="review-text">“${rev.text}”</p>
                        <footer class="review-author">
                            <div class="author-initial" aria-hidden="true">${rev.author.charAt(0)}</div>
                            <div class="author-meta">
                                <strong>${rev.author}</strong>
                                <span>${rev.source}</span>
                            </div>
                        </footer>
                    </blockquote>
                `,
                    )
                    .join("");

                grid.classList.remove("is-fading");
                renderDots();
            };

            if (!animate) {
                updateDom();
                return;
            }

            grid.classList.add("is-fading");
            setTimeout(updateDom, 220);
        }

        function startAutoplay() {
            if (timerId) clearInterval(timerId);
            timerId = setInterval(() => {
                if (isPaused) return;
                currentPage = (currentPage + 1) % totalPages;
                renderPage(true);
            }, 5500);
        }

        container.addEventListener("mouseenter", () => (isPaused = true));
        container.addEventListener("mouseleave", () => (isPaused = false));
        container.addEventListener("touchstart", () => (isPaused = true), {
            passive: true,
        });

        window.addEventListener("resize", () => {
            const nextBatch = getBatchSize();
            if (nextBatch !== batchSize) {
                batchSize = nextBatch;
                totalPages = Math.ceil(allReviews.length / batchSize);
                currentPage = currentPage % totalPages;
                renderPage(false);
            }
        });

        renderPage(false);
        startAutoplay();
    });
</script>

<style>
    .section-reviews {
        width: 100%;
    }

    .content-wrapper {
        display: flex;
        flex-direction: column;
        width: 100%;
        margin: 0 auto;
        gap: clamp(1.35rem, 3.2vh, 2.2rem);
    }

    .header-content {
        max-width: 740px;
        gap: 8px;
        width: 100%;
    }

    .section-title {
        font-size: clamp(1.9rem, 4.4vw, 3.2rem);
        letter-spacing: -0.03em;
        line-height: 1.12;
        color: var(--text-main);
    }

    .body-text {
        font-size: clamp(0.92rem, 1.6vw, 1.05rem);
        color: var(--text-muted);
        line-height: 1.5;
        max-width: 58ch;
    }

    .reviews-container {
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .reviews-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
        transition: opacity 0.22s ease;
    }

    .reviews-grid.is-fading {
        opacity: 0;
    }

    :global(.review-enter) {
        animation: reviewFadeUp 0.45s cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    @keyframes reviewFadeUp {
        from {
            opacity: 0;
            transform: translateY(10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    :global(.review-card) {
        margin: 0;
        padding: clamp(1.15rem, 2.2vw, 1.7rem);
        border-radius: var(--radius-lg);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 14px;
        transition:
            transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
            border-color 0.25s ease;
    }

    :global(.review-card:hover) {
        transform: translateY(-3px);
        border-color: var(--primary);
    }

    :global(.review-card-top) {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        flex-wrap: wrap;
    }

    :global(.stars-row) {
        display: inline-flex;
        align-items: center;
        gap: 2px;
        color: var(--accent-warm);
    }

    :global(.review-highlight-pill) {
        font-size: 0.72rem;
        font-weight: 700;
        padding: 3px 10px;
        border-radius: 999px;
        background: var(--primary-soft);
        color: var(--primary);
        border: 1px solid color-mix(in srgb, var(--primary) 22%, transparent);
    }

    :global(.review-text) {
        margin: 0;
        font-size: 0.93rem;
        line-height: 1.52;
        color: var(--text-main);
        flex-grow: 1;
    }

    :global(.review-author) {
        display: flex;
        align-items: center;
        gap: 10px;
        padding-top: 10px;
        border-top: 1px solid var(--border);
    }

    :global(.author-initial) {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: var(--bg-card-inner);
        border: 1px solid var(--border-strong);
        color: var(--primary);
        font-size: 0.82rem;
        font-weight: 750;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    :global(.author-meta) {
        display: flex;
        flex-direction: column;
        line-height: 1.25;
    }

    :global(.author-meta strong) {
        font-size: 0.84rem;
        font-weight: 700;
        color: var(--text-main);
    }

    :global(.author-meta span) {
        font-size: 0.72rem;
        color: var(--text-muted);
    }

    .reviews-dots {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
    }

    :global(.rev-dot) {
        width: 6px;
        height: 6px;
        border-radius: 99px;
        border: none;
        padding: 0;
        background: var(--text-muted);
        opacity: 0.28;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    :global(.rev-dot.active) {
        background: var(--primary);
        opacity: 0.85;
        width: 18px;
    }

    @media (max-width: 820px) {
        .reviews-grid {
            grid-template-columns: minmax(0, 1fr);
            gap: 12px;
        }

        :global(.review-card:nth-child(n + 3)) {
            display: none;
        }

        :global(.review-card) {
            padding: 13px 15px;
            gap: 10px;
            border-radius: var(--radius-md);
        }

        :global(.review-text) {
            font-size: 0.85rem;
            line-height: 1.44;
        }

        :global(.review-author) {
            padding-top: 8px;
        }
    }
</style>
