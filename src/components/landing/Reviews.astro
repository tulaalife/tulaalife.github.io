---
const currentLang = Astro.currentLocale || "en";

const ui = {
    en: {
        badge: "★ 4.9 Rated on App Store & Google Play",
        titleTop: "Loved for Daily",
        titleBottom: "Calm & Privacy.",
        desc: "Real words from people practicing yoga, meditation, and cycle tracking with Tulaa.",
        reviews: [
            {
                highlight: "Private & Calming",
                text: "Finally a period tracker and gentle yoga app that never asks for my phone number or pushes paid plans. Truly calming.",
                author: "Ananya M.",
                source: "Google Play",
            },
            {
                highlight: "Deep Sleep in 5 Mins",
                text: "I love the bedtime meditations. Listening to them at night helps me unwind and fall asleep within 5 minutes.",
                author: "Sneha R.",
                source: "Google Play",
            },
            {
                highlight: "Peaceful & Ad-Free",
                text: "So refreshing to open an app with zero ads and practice therapeutic yoga offline whenever my body needs relief.",
                author: "Prerna1407",
                source: "App Store",
            },
        ],
    },
    hi: {
        badge: "★ 4.9 रेटिंग • App Store व Google Play",
        titleTop: "दैनिक शांति और गोपनीयता",
        titleBottom: "के लिए सराहा गया।",
        desc: "Tulaa के साथ रोज़ाना योग, ध्यान और हेल्थ ट्रैकिंग करने वाले यूज़र्स के अनुभव।",
        reviews: [
            {
                highlight: "निजी और शांत",
                text: "आख़िरकार एक ऐसा पीरियड ट्रैकर और योग ऐप मिला जो न फोन नंबर मांगता है और न कोई सब्सक्रिप्शन। बहुत ही भरोसेमंद।",
                author: "अनन्या एम.",
                source: "Google Play",
            },
            {
                highlight: "5 मिनट में गहरी नींद",
                text: "सोने से पहले इसके मेडिटेशन सुनने से दिनभर की थकान मिट जाती है और मुझे 5 मिनट में गहरी नींद आ जाती है।",
                author: "स्नेहा आर.",
                source: "Google Play",
            },
            {
                highlight: "विज्ञापन-मुक्त अभ्यास",
                text: "बिना विज्ञापनों के कभी भी ऑफलाइन योग अभ्यास करने के लिए यह सबसे सरल और शांत ऐप है।",
                author: "प्रेरणा1407",
                source: "App Store",
            },
        ],
    },
};

const t = ui[currentLang as keyof typeof ui] || ui.en;
---

<section id="community-love" class="scroll-section section-reviews">
    <div class="content-wrapper">
        <div class="container">
            <div class="section-header-left header-content animate-on-scroll">
                <span class="badge-small">{t.badge}</span>
                <h2 class="section-title">
                    <span class="title-main">{t.titleTop}</span>{" "}
                    <span class="text-gradient">{t.titleBottom}</span>
                </h2>
                <p class="body-text">{t.desc}</p>
            </div>
        </div>

        <div class="container reviews-container animate-on-scroll delay-1">
            <div class="reviews-grid">
                {
                    t.reviews.map((rev) => (
                        <blockquote class="review-card premium-gloss-surface">
                            <div class="review-card-top">
                                <div class="stars-row" aria-hidden="true">
                                    {[1, 2, 3, 4, 5].map(() => (
                                        <svg
                                            viewBox="0 0 20 20"
                                            width="15"
                                            height="15"
                                            fill="currentColor"
                                        >
                                            <polygon points="10 1.5 12.6 6.8 18.5 7.6 14.2 11.8 15.2 17.6 10 14.8 4.8 17.6 5.8 11.8 1.5 7.6 7.4 6.8 10 1.5" />
                                        </svg>
                                    ))}
                                </div>
                                <span class="review-highlight-pill">
                                    {rev.highlight}
                                </span>
                            </div>

                            <p class="review-text">“{rev.text}”</p>

                            <footer class="review-author">
                                <div class="author-initial" aria-hidden="true">
                                    {rev.author.charAt(0)}
                                </div>
                                <div class="author-meta">
                                    <strong>{rev.author}</strong>
                                    <span>{rev.source}</span>
                                </div>
                            </footer>
                        </blockquote>
                    ))
                }
            </div>
        </div>
    </div>
</section>

<style>
    .section-reviews {
        width: 100%;
    }

    .content-wrapper {
        display: flex;
        flex-direction: column;
        width: 100%;
        margin: 0 auto;
        gap: clamp(1.1rem, 3vh, 2rem);
    }

    .header-content {
        max-width: 740px;
        gap: 8px;
        width: 100%;
    }

    .section-title {
        font-size: clamp(1.9rem, 4.4vw, 3.2rem);
        letter-spacing: -0.03em;
        line-height: 1.12;
        color: var(--text-main);
    }

    .body-text {
        font-size: clamp(0.92rem, 1.6vw, 1.05rem);
        color: var(--text-muted);
        line-height: 1.5;
        max-width: 58ch;
    }

    .reviews-container {
        width: 100%;
    }

    .reviews-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 18px;
    }

    .review-card {
        margin: 0;
        padding: clamp(1.25rem, 2.4vw, 1.85rem);
        border-radius: var(--radius-lg);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 16px;
        transition:
            transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
            border-color 0.25s ease;
    }

    .review-card:hover {
        transform: translateY(-3px);
        border-color: var(--primary);
    }

    .review-card-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        flex-wrap: wrap;
    }

    .stars-row {
        display: inline-flex;
        align-items: center;
        gap: 2px;
        color: var(--accent-warm);
    }

    .review-highlight-pill {
        font-size: 0.72rem;
        font-weight: 700;
        padding: 3px 10px;
        border-radius: 999px;
        background: var(--primary-soft);
        color: var(--primary);
        border: 1px solid color-mix(in srgb, var(--primary) 22%, transparent);
    }

    .review-text {
        margin: 0;
        font-size: 0.96rem;
        line-height: 1.55;
        color: var(--text-main);
        flex-grow: 1;
    }

    .review-author {
        display: flex;
        align-items: center;
        gap: 10px;
        padding-top: 12px;
        border-top: 1px solid var(--border);
    }

    .author-initial {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: var(--bg-card-inner);
        border: 1px solid var(--border-strong);
        color: var(--primary);
        font-size: 0.85rem;
        font-weight: 750;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .author-meta {
        display: flex;
        flex-direction: column;
        line-height: 1.25;
    }

    .author-meta strong {
        font-size: 0.86rem;
        font-weight: 700;
        color: var(--text-main);
    }

    .author-meta span {
        font-size: 0.74rem;
        color: var(--text-muted);
    }

    @media (max-width: 820px) {
        .reviews-grid {
            grid-template-columns: minmax(0, 1fr);
            gap: 10px;
        }

        .review-card {
            padding: 14px 16px;
            gap: 10px;
            border-radius: var(--radius-md);
        }

        .review-text {
            font-size: 0.85rem;
            line-height: 1.42;
        }

        .review-author {
            padding-top: 8px;
        }

        .author-initial {
            width: 28px;
            height: 28px;
            font-size: 0.76rem;
        }

        .author-meta strong {
            font-size: 0.8rem;
        }

        .author-meta span {
            font-size: 0.7rem;
        }
    }
</style>
