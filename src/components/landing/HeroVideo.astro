---
import StoreButtons from "../StoreButtons.astro";

const currentLang = Astro.currentLocale || "en";

const ui = {
    en: {
        basePoster: "poster",
        badge: "Download Once • Practice Offline",
        titleTop: "Simple Sessions,",
        titleBottom: "Visible Results.",
        body: "Follow step-by-step video demonstrations and self-paced practice timers—with zero ad interruptions, zero OTP prompts, and no internet needed.",
        points: [
            "Beginner-safe poses with clear posture cues & cautions",
            "10 to 15 minute targeted routines for busy schedules",
            "Save sessions to your phone and practice offline anywhere",
        ],
    },
    hi: {
        basePoster: "poster-hindi",
        badge: "एक बार डाउनलोड करें • ऑफलाइन अभ्यास करें",
        titleTop: "आसान, सुरक्षित अभ्यास,",
        titleBottom: "असरदार परिणाम।",
        body: "स्पष्ट वीडियो डेमो और इन-बिल्ट प्रैक्टिस टाइमर के साथ योग सीखें — बिना किसी विज्ञापन, बिना OTP और बिना इंटरनेट की ज़रूरत के।",
        points: [
            "नए अभ्यासियों के लिए सुरक्षित आसन और स्पष्ट सावधानियां",
            "व्यस्त दिनचर्या के लिए 10 से 15 मिनट के आसान सत्र",
            "वीडियो एक बार फोन में सेव करें और कहीं भी ऑफलाइन अभ्यास करें",
        ],
    },
};

const t = ui[currentLang as keyof typeof ui] || ui.en;

const mobilePoster = `/images/mobile/${t.basePoster}.webp`;
const desktopPoster = `/images/desktop/${t.basePoster}.webp`;

const videoWebm =
    currentLang === "hi"
        ? "/website-app-demo-hindi.webm"
        : "/website-app-demo.webm";
const videoMp4 =
    currentLang === "hi"
        ? "/website-app-demo-hindi.mp4"
        : "/website-app-demo.mp4";
---

<section class="scroll-section video-section">
    <div class="container video-grid">
        <div class="video-copy animate-on-scroll">
            <span class="badge-small">{t.badge}</span>
            <h2 class="section-title">
                {t.titleTop}<br />
                <span class="text-gradient">{t.titleBottom}</span>
            </h2>
            <p class="body-text">{t.body}</p>
            <ul class="video-points">
                {t.points.map((pt) => <li>{pt}</li>)}
            </ul>
            <div class="video-cta">
                <StoreButtons />
            </div>
        </div>

        <div class="visual-backlightstage">
            <div
                class="phone-frame-wrapper animate-on-scroll"
                id="phoneWrapper"
                data-webm={videoWebm}
                data-mp4={videoMp4}
            >
                <div class="video-loader" id="videoLoader"></div>
                <picture>
                    <source media="(min-width: 768px)" srcset={desktopPoster} />
                    <img
                        src={mobilePoster}
                        alt="Tulaa App Preview"
                        class="poster-img"
                        id="posterImg"
                        fetchpriority="high"
                        loading="eager"
                    />
                </picture>
                <video
                    id="heroVideo"
                    class="app-video"
                    loop
                    muted
                    playsinline
                    preload="none"></video>
            </div>
        </div>
    </div>
</section>

<script>
    document.addEventListener("astro:page-load", () => {
        const wrapper = document.getElementById("phoneWrapper");
        const video = document.getElementById("heroVideo") as HTMLVideoElement;
        const loader = document.getElementById("videoLoader");
        const poster = document.getElementById("posterImg");

        if (!wrapper || !video) return;

        const initVideo = () => {
            const webmSrc = wrapper.getAttribute("data-webm");
            const mp4Src = wrapper.getAttribute("data-mp4");

            if (
                webmSrc &&
                video.querySelectorAll('source[type="video/webm"]').length === 0
            ) {
                const s = document.createElement("source");
                s.src = webmSrc;
                s.type = "video/webm";
                video.appendChild(s);
            }
            if (
                mp4Src &&
                video.querySelectorAll('source[type="video/mp4"]').length === 0
            ) {
                const s = document.createElement("source");
                s.src = mp4Src;
                s.type = "video/mp4";
                video.appendChild(s);
            }

            video.addEventListener(
                "playing",
                () => {
                    video.classList.add("is-playing");
                    if (loader) loader.style.opacity = "0";
                    setTimeout(() => {
                        if (poster)
                            (poster as HTMLElement).style.visibility = "hidden";
                        if (loader) loader.style.display = "none";
                    }, 1000);
                },
                { once: true },
            );

            video.load();
            video.play().catch(() => {
                if (loader) loader.style.display = "none";
            });
        };

        const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        initVideo();
                        observer.disconnect();
                    }
                });
            },
            { threshold: 0.15 },
        );

        observer.observe(wrapper);

        document.addEventListener("visibilitychange", () => {
            if (document.visibilityState === "visible") {
                video.play().catch(() => {});
            }
        });
    });
</script>

<style>
    .video-section {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .video-grid {
        display: grid;
        grid-template-columns: 1.1fr 0.9fr;
        gap: clamp(2rem, 5vw, 4rem);
        align-items: center;
    }

    .video-copy {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        text-align: left;
        gap: var(--space-sm);
    }

    .video-copy .section-title {
        font-size: clamp(2rem, 4.5vw, 3.4rem);
        line-height: 1.12;
        letter-spacing: -0.03em;
    }

    .video-points {
        list-style: none;
        padding: 0;
        margin: var(--space-xs) 0 var(--space-sm);
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .video-points li {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 1rem;
        font-weight: 500;
        color: var(--text-main);
    }

    .video-points li::before {
        content: "✓";
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 22px;
        height: 22px;
        border-radius: 50%;
        background: color-mix(in srgb, var(--primary) 14%, transparent);
        color: var(--primary);
        font-size: 0.78rem;
        font-weight: 800;
        flex-shrink: 0;
    }

    .video-cta {
        width: 100%;
        margin-top: var(--space-xs);
    }

    .visual-backlightstage {
        position: relative;
        display: flex;
        justify-content: center;
        align-items: center;
        width: 100%;
        padding: 1rem 0;
    }

    .visual-backlightstage::before {
        content: "";
        position: absolute;
        width: 650px;
        height: 650px;
        background: radial-gradient(
            circle,
            color-mix(in srgb, var(--primary) 8%, transparent) 0%,
            transparent 70%
        );
        z-index: 1;
        pointer-events: none;
    }

    .phone-frame-wrapper {
        position: relative;
        z-index: 2;
        width: auto;
        height: 72dvh;
        max-height: 760px;
        aspect-ratio: 540 / 1174;
        background-color: var(--bg-sub);
        border-radius: 44px;

        border: 1px solid color-mix(in srgb, var(--text-main) 10%, transparent);
        box-shadow:
            0 0 0 6px color-mix(in srgb, var(--bg-sub) 60%, transparent),
            0 12px 40px -8px
                color-mix(in srgb, var(--text-main) 12%, transparent);
        backdrop-filter: blur(16px);

        overflow: hidden;
    }

    .app-video {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0;
        transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        z-index: 10;
    }

    .app-video.is-playing {
        opacity: 1;
    }

    .poster-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        position: absolute;
        inset: 0;
        z-index: 5;
    }

    .video-loader {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 36px;
        height: 36px;
        border: 2px solid color-mix(in srgb, var(--text-muted), transparent 90%);
        border-top-color: var(--primary);
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
        z-index: 6;
        transition: opacity 0.4s ease;
    }

    @keyframes spin {
        to {
            transform: translate(-50%, -50%) rotate(360deg);
        }
    }

    @media (max-width: 860px) {
        .video-grid {
            grid-template-columns: 1fr;
            gap: 2rem;
        }

        .phone-frame-wrapper {
            height: 58dvh;
            max-height: 520px;
            border-radius: 32px;
        }

        .visual-backlightstage {
            padding: 0.5rem 0;
        }

        .visual-backlightstage::before {
            width: 320px;
            height: 320px;
        }
    }
</style>
