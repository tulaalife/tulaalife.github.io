---
import StoreButtons from "../StoreButtons.astro";

const currentLang = Astro.currentLocale || "en";

const ui = {
    en: {
        basePoster: "poster",
        badge: "Guided Video • Built-In Timers",
        titleTop: "Simple Sessions,",
        titleBottom: "Lasting Relief.",
        body: "15-minute beginner-safe routines with clear posture cues, safety cautions, and offline playback.",
        pills: [
            { label: "HD Posture Demos", icon: "video" },
            { label: "Self-Paced Timers", icon: "timer" },
            { label: "Works 100% Offline", icon: "offline" },
        ],
        floatTop: "15-Min Daily Flow",
        floatBottom: "Zero Ads • Zero Login",
    },
    hi: {
        basePoster: "poster-hindi",
        badge: "स्पष्ट वीडियो • इन-बिल्ट टाइमर",
        titleTop: "आसान अभ्यास,",
        titleBottom: "गहरा आराम।",
        body: "15-मिनट के सुरक्षित योग सत्र — स्पष्ट आसन निर्देश, सावधानियां और बिना इंटरनेट ऑफलाइन अभ्यास।",
        pills: [
            { label: "स्पष्ट वीडियो डेमो", icon: "video" },
            { label: "प्रैक्टिस टाइमर", icon: "timer" },
            { label: "100% ऑफलाइन", icon: "offline" },
        ],
        floatTop: "15-मिनट दैनिक अभ्यास",
        floatBottom: "बिना विज्ञापन • बिना लॉगिन",
    },
};

const t = ui[currentLang as keyof typeof ui] || ui.en;

const mobilePoster = `/images/mobile/${t.basePoster}.webp`;
const desktopPoster = `/images/desktop/${t.basePoster}.webp`;

const videoWebm =
    currentLang === "hi"
        ? "/website-app-demo-hindi.webm"
        : "/website-app-demo.webm";
const videoMp4 =
    currentLang === "hi"
        ? "/website-app-demo-hindi.mp4"
        : "/website-app-demo.mp4";
---

<section id="app-preview" class="scroll-section video-section">
    <div class="container video-grid">
        <div class="video-copy animate-on-scroll">
            <span class="badge-small">{t.badge}</span>
            <h2 class="section-title">
                {t.titleTop}<br />
                <span class="text-gradient">{t.titleBottom}</span>
            </h2>
            <p class="body-text">{t.body}</p>

            <div class="feature-chips-grid">
                {
                    t.pills.map((pill) => (
                        <div class="feature-chip premium-gloss-surface">
                            <span class="chip-icon" aria-hidden="true">
                                {pill.icon === "video" && (
                                    <svg
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                    >
                                        <polygon points="5 3 19 12 5 21 5 3" />
                                    </svg>
                                )}
                                {pill.icon === "timer" && (
                                    <svg
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                    >
                                        <circle cx="12" cy="13" r="8" />
                                        <path d="M12 9v4l2 2" />
                                        <path d="M9 3h6" />
                                    </svg>
                                )}
                                {pill.icon === "offline" && (
                                    <svg
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                    >
                                        <path d="M12 3v12" />
                                        <path d="m8 11 4 4 4-4" />
                                        <path d="M4 19h16" />
                                    </svg>
                                )}
                            </span>
                            <span class="chip-label">{pill.label}</span>
                        </div>
                    ))
                }
            </div>

            <div class="video-cta desktop-only-cta">
                <StoreButtons compact={true} />
            </div>
        </div>

        <div class="visual-backlightstage">
            <div
                class="floating-pill float-top premium-gloss-surface animate-on-scroll delay-1"
            >
                <span class="pulse-dot"></span>
                <span>{t.floatTop}</span>
            </div>

            <div
                class="phone-frame-wrapper animate-on-scroll"
                id="phoneWrapper"
                data-webm={videoWebm}
                data-mp4={videoMp4}
            >
                <div class="video-loader" id="videoLoader"></div>
                <picture>
                    <source media="(min-width: 768px)" srcset={desktopPoster} />
                    <img
                        src={mobilePoster}
                        alt="Tulaa App Preview"
                        class="poster-img"
                        id="posterImg"
                        fetchpriority="high"
                        loading="eager"
                    />
                </picture>
                <video
                    id="heroVideo"
                    class="app-video"
                    loop
                    muted
                    playsinline
                    preload="none"></video>
            </div>

            <div
                class="floating-pill float-bottom premium-gloss-surface animate-on-scroll delay-2"
            >
                <svg
                    viewBox="0 0 24 24"
                    width="14"
                    height="14"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"
                    ></path>
                </svg>
                <span>{t.floatBottom}</span>
            </div>
        </div>
    </div>
</section>

<script>
    document.addEventListener("astro:page-load", () => {
        const wrapper = document.getElementById("phoneWrapper");
        const video = document.getElementById("heroVideo") as HTMLVideoElement;
        const loader = document.getElementById("videoLoader");
        const poster = document.getElementById("posterImg");

        if (!wrapper || !video) return;

        const initVideo = () => {
            const webmSrc = wrapper.getAttribute("data-webm");
            const mp4Src = wrapper.getAttribute("data-mp4");

            if (
                webmSrc &&
                video.querySelectorAll('source[type="video/webm"]').length === 0
            ) {
                const s = document.createElement("source");
                s.src = webmSrc;
                s.type = "video/webm";
                video.appendChild(s);
            }
            if (
                mp4Src &&
                video.querySelectorAll('source[type="video/mp4"]').length === 0
            ) {
                const s = document.createElement("source");
                s.src = mp4Src;
                s.type = "video/mp4";
                video.appendChild(s);
            }

            video.addEventListener(
                "playing",
                () => {
                    video.classList.add("is-playing");
                    if (loader) loader.style.opacity = "0";
                    setTimeout(() => {
                        if (poster)
                            (poster as HTMLElement).style.visibility = "hidden";
                        if (loader) loader.style.display = "none";
                    }, 1000);
                },
                { once: true },
            );

            video.load();
            video.play().catch(() => {
                if (loader) loader.style.display = "none";
            });
        };

        const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        initVideo();
                        observer.disconnect();
                    }
                });
            },
            { threshold: 0.15 },
        );

        observer.observe(wrapper);

        document.addEventListener("visibilitychange", () => {
            if (document.visibilityState === "visible") {
                video.play().catch(() => {});
            }
        });
    });
</script>

<style>
    .video-section {
        width: 100%;
    }

    .video-grid {
        display: grid;
        grid-template-columns: 1.05fr 0.95fr;
        gap: clamp(1.5rem, 4vw, 3.5rem);
        align-items: center;
    }

    .video-copy {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        text-align: left;
        gap: 12px;
    }

    .video-copy .section-title {
        font-size: clamp(2rem, 4.4vw, 3.35rem);
        line-height: 1.1;
        letter-spacing: -0.03em;
    }

    .feature-chips-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin: 6px 0;
    }

    .feature-chip {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 9px 14px;
        border-radius: 999px;
        background: var(--bg-card-inner);
        border: 1px solid var(--border);
    }

    .chip-icon {
        width: 24px;
        height: 24px;
        border-radius: 50%;
        background: var(--primary-soft);
        color: var(--primary);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .chip-icon svg {
        width: 13px;
        height: 13px;
    }

    .chip-label {
        font-size: 0.85rem;
        font-weight: 650;
        color: var(--text-main);
        white-space: nowrap;
    }

    .video-cta {
        width: 100%;
        margin-top: 6px;
    }

    .visual-backlightstage {
        position: relative;
        display: flex;
        justify-content: center;
        align-items: center;
        width: 100%;
    }

    .visual-backlightstage::before {
        content: "";
        position: absolute;
        width: 520px;
        height: 520px;
        background: radial-gradient(
            circle,
            color-mix(in srgb, var(--primary) 14%, transparent) 0%,
            transparent 70%
        );
        z-index: 1;
        pointer-events: none;
    }

    .floating-pill {
        position: absolute;
        z-index: 12;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 14px;
        border-radius: 999px;
        font-size: 0.78rem;
        font-weight: 650;
        color: var(--text-main);
        white-space: nowrap;
    }

    .float-top {
        top: 12%;
        left: 4%;
    }

    .float-bottom {
        bottom: 12%;
        right: 4%;
        color: var(--primary);
    }

    .pulse-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--primary);
        box-shadow: 0 0 0 4px var(--primary-soft);
    }

    .phone-frame-wrapper {
        position: relative;
        z-index: 2;
        width: auto;
        height: 68dvh;
        max-height: 680px;
        aspect-ratio: 540 / 1174;
        background-color: var(--bg-sub);
        border-radius: 40px;
        border: 1px solid var(--border-strong);
        box-shadow:
            0 0 0 6px color-mix(in srgb, var(--bg-sub) 65%, transparent),
            var(--shadow);
        backdrop-filter: blur(16px);
        overflow: hidden;
    }

    .app-video {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0;
        transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        z-index: 10;
    }

    .app-video.is-playing {
        opacity: 1;
    }

    .poster-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        position: absolute;
        inset: 0;
        z-index: 5;
    }

    .video-loader {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 34px;
        height: 34px;
        border: 2px solid color-mix(in srgb, var(--text-muted), transparent 85%);
        border-top-color: var(--primary);
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
        z-index: 6;
        transition: opacity 0.4s ease;
    }

    @keyframes spin {
        to {
            transform: translate(-50%, -50%) rotate(360deg);
        }
    }

    @media (max-width: 860px) {
        .video-grid {
            grid-template-columns: 1fr;
            gap: 0.85rem;
            text-align: center;
        }

        .video-copy {
            align-items: center;
            text-align: center;
            gap: 6px;
        }

        .video-copy .section-title {
            font-size: clamp(1.6rem, 6vw, 2.1rem);
        }

        .video-copy .body-text {
            font-size: 0.86rem;
            line-height: 1.4;
        }

        .feature-chips-grid {
            justify-content: center;
            gap: 6px;
            margin: 2px 0;
        }

        .feature-chip {
            padding: 5px 10px;
            gap: 5px;
        }

        .chip-icon {
            width: 18px;
            height: 18px;
        }

        .chip-icon svg {
            width: 10px;
            height: 10px;
        }

        .chip-label {
            font-size: 0.74rem;
        }

        .desktop-only-cta {
            display: none;
        }

        .floating-pill {
            display: none;
        }

        .phone-frame-wrapper {
            height: 50dvh;
            max-height: 430px;
            border-radius: 28px;
        }

        .visual-backlightstage::before {
            width: 280px;
            height: 280px;
        }
    }
</style>
