---
const currentLang = Astro.currentLocale || "en";

const ui = {
    en: {
        badge: "Meet Your Yoga Therapist",
        role: "Founder of Tulaa & YogaWithLatika",
        name: "Latika Bissa",
        bio: "Every routine in Tulaa is clinically designed by Latika to help you relieve pain, balance hormones, and restore daily calm safely at home.",
        siteLabel: "yogawithlatika.com",
        creds: [
            {
                metric: "Gold Medalist",
                label: "M.Sc. in Yoga Therapy",
                icon: "medal",
                tone: "warm",
            },
            {
                metric: "12+ Years Experience",
                label: "Clinical Yoga Therapy",
                icon: "exp",
                tone: "sage",
            },
            {
                metric: "50 Lakh+ Views",
                label: "★ 5.0 Rated on Google",
                icon: "star",
                tone: "warm",
            },
            {
                metric: "Clinical Specialist",
                label: "Pain, PCOS & Prenatal Care",
                icon: "heart",
                tone: "sage",
            },
        ],
    },
    hi: {
        badge: "आपकी योग थेरेपिस्ट से मिलें",
        role: "संस्थापक, Tulaa और YogaWithLatika",
        name: "लतिका बिस्सा",
        bio: "Tulaa का हर योग प्लान लतिका द्वारा वैज्ञानिक रूप से तैयार किया गया है, ताकि आप घर बैठे दर्द, हार्मोनल असंतुलन और तनाव से सुरक्षित राहत पा सकें।",
        siteLabel: "yogawithlatika.com",
        creds: [
            {
                metric: "स्वर्ण पदक विजेता",
                label: "M.Sc. योग थेरेपी",
                icon: "medal",
                tone: "warm",
            },
            {
                metric: "12+ वर्ष अनुभव",
                label: "क्लिनिकल योग चिकित्सा",
                icon: "exp",
                tone: "sage",
            },
            {
                metric: "50 लाख+ व्यूज़",
                label: "★ 5.0 गूगल रेटिंग",
                icon: "star",
                tone: "warm",
            },
            {
                metric: "विशेषज्ञ देखभाल",
                label: "दर्द, PCOS व प्रेगनेंसी",
                icon: "heart",
                tone: "sage",
            },
        ],
    },
};

const t = ui[currentLang as keyof typeof ui] || ui.en;
---

<section id="therapist" class="scroll-section author-section">
    <div class="container author-shell">
        <div class="author-card premium-gloss-surface animate-on-scroll">
            <div class="author-top">
                <div class="avatar-frame">
                    <div class="avatar-ring themed-media">
                        <img
                            src="/images/latika.png"
                            alt={t.name}
                            width="140"
                            height="140"
                            loading="lazy"
                            decoding="async"
                        />
                    </div>
                </div>

                <div class="author-intro">
                    <span class="badge-small">{t.badge}</span>
                    <h2 class="author-name">
                        {t.name}
                    </h2>
                    <p class="author-role">{t.role}</p>
                    <p class="author-bio body-text">{t.bio}</p>

                    <a
                        href="https://yogawithlatika.com"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="author-website-pill"
                    >
                        <svg
                            viewBox="0 0 24 24"
                            width="15"
                            height="15"
                            fill="none"
                            aria-hidden="true"
                        >
                            <circle
                                cx="12"
                                cy="12"
                                r="10"
                                fill="currentColor"
                                fill-opacity="0.16"
                                stroke="currentColor"
                                stroke-width="1.8"></circle>
                            <path
                                d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20M2 12h20"
                                stroke="currentColor"
                                stroke-width="1.6"></path>
                        </svg>
                        <span>{t.siteLabel}</span>
                        <span class="ext-arrow" aria-hidden="true">↗</span>
                    </a>
                </div>
            </div>

            <div class="creds-grid">
                {
                    t.creds.map((c) => (
                        <div class:list={["cred-item", `tone-${c.tone}`]}>
                            <div class="cred-icon" aria-hidden="true">
                                {c.icon === "medal" && (
                                    <svg viewBox="0 0 28 28" fill="none">
                                        <path
                                            d="M9.5 14.5L7.5 25l6.5-3.5L20.5 25l-2-10.5"
                                            fill="currentColor"
                                            fill-opacity="0.2"
                                            stroke="currentColor"
                                            stroke-width="1.8"
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                        />
                                        <circle
                                            cx="14"
                                            cy="10"
                                            r="6.5"
                                            fill="currentColor"
                                            fill-opacity="0.28"
                                            stroke="currentColor"
                                            stroke-width="1.9"
                                        />
                                        <circle
                                            cx="14"
                                            cy="10"
                                            r="2.5"
                                            fill="currentColor"
                                        />
                                    </svg>
                                )}
                                {c.icon === "exp" && (
                                    <svg viewBox="0 0 28 28" fill="none">
                                        <circle
                                            cx="14"
                                            cy="14"
                                            r="10"
                                            fill="currentColor"
                                            fill-opacity="0.2"
                                            stroke="currentColor"
                                            stroke-width="1.9"
                                        />
                                        <path
                                            d="M14 9v5l3.5 2"
                                            stroke="currentColor"
                                            stroke-width="2"
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                        />
                                    </svg>
                                )}
                                {c.icon === "star" && (
                                    <svg viewBox="0 0 28 28" fill="none">
                                        <polygon
                                            points="14 3 17.4 9.9 25 11 19.5 16.4 20.8 24 14 20.4 7.2 24 8.5 16.4 3 11 10.6 9.9 14 3"
                                            fill="currentColor"
                                            fill-opacity="0.28"
                                            stroke="currentColor"
                                            stroke-width="1.9"
                                            stroke-linejoin="round"
                                        />
                                    </svg>
                                )}
                                {c.icon === "heart" && (
                                    <svg viewBox="0 0 28 28" fill="none">
                                        <path
                                            d="M22.5 15.8c1.7-1.7 3.5-3.7 3.5-6.4A6.4 6.4 0 0 0 19.6 3c-2 0-3.5.6-5.6 2.4C11.9 3.6 10.4 3 8.4 3A6.4 6.4 0 0 0 2 9.4c0 2.7 1.8 4.7 3.5 6.4L14 24l8.5-8.2Z"
                                            fill="currentColor"
                                            fill-opacity="0.25"
                                            stroke="currentColor"
                                            stroke-width="1.9"
                                            stroke-linejoin="round"
                                        />
                                        <path
                                            d="M14 10v6M11 13h6"
                                            stroke="currentColor"
                                            stroke-width="1.9"
                                            stroke-linecap="round"
                                        />
                                    </svg>
                                )}
                            </div>
                            <div class="cred-copy">
                                <strong class="cred-metric">{c.metric}</strong>
                                <span class="cred-label">{c.label}</span>
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </div>
</section>

<style>
    .author-section {
        width: 100%;
    }

    .author-shell {
        max-width: 820px;
        margin: 0 auto;
    }

    .author-card {
        position: relative;
        border-radius: var(--radius-lg);
        padding: clamp(1.35rem, 3.2vw, 2.35rem);
        display: flex;
        flex-direction: column;
        gap: clamp(1.1rem, 2.5vh, 1.75rem);
        overflow: hidden;
    }

    .author-top {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        gap: clamp(1.25rem, 3.5vw, 2.25rem);
    }

    .avatar-frame {
        position: relative;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .avatar-ring {
        position: relative;
        width: 136px;
        height: 136px;
        border-radius: 50%;
        overflow: hidden;
        border: 3px solid color-mix(in srgb, var(--primary) 45%, var(--border));
        background: var(--bg-sub);
        box-shadow:
            0 10px 24px -6px var(--primary-glow),
            var(--shadow-sm);
    }

    .avatar-ring img {
        position: absolute;
        width: 148%;
        height: auto;
        left: 50%;
        top: 18%;
        transform: translateX(-50%);
    }

    .author-intro {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        text-align: left;
        gap: 6px;
        min-width: 0;
    }

    .author-name {
        font-size: clamp(1.85rem, 4vw, 2.65rem);
        letter-spacing: -0.03em;
        line-height: 1.1;
        color: var(--text-main);
        margin-top: 2px;
    }

    .author-role {
        font-size: 0.92rem;
        font-weight: 650;
        color: var(--primary);
        margin: 0;
    }

    .author-bio {
        font-size: clamp(0.88rem, 1.5vw, 0.98rem);
        line-height: 1.52;
        color: var(--text-muted);
        margin-top: 2px;
    }

    .author-website-pill {
        margin-top: 6px;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 7px 14px;
        border-radius: 999px;
        background: var(--bg-card-inner);
        border: 1px solid var(--border-strong);
        color: var(--text-main);
        font-size: 0.82rem;
        font-weight: 650;
        transition:
            transform 0.2s ease,
            border-color 0.2s ease,
            color 0.2s ease;
    }

    .author-website-pill svg {
        color: var(--primary);
    }

    .author-website-pill:hover {
        transform: translateY(-2px);
        border-color: var(--primary);
        color: var(--primary);
    }

    .ext-arrow {
        color: var(--primary);
        font-size: 0.88rem;
    }

    /* Spacious 2x2 Grid so credential copies never clip */
    .creds-grid {
        position: relative;
        z-index: 2;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
        padding-top: clamp(0.9rem, 2vh, 1.35rem);
        border-top: 1px solid var(--border);
    }

    .cred-item {
        --cred-color: var(--primary);
        --cred-soft: var(--primary-soft);
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 13px 16px;
        border-radius: var(--radius-md);
        background: var(--bg-card-inner);
        border: 1px solid var(--border);
        min-width: 0;
        transition:
            transform 0.2s ease,
            border-color 0.2s ease;
    }

    .cred-item:hover {
        transform: translateY(-2px);
        border-color: var(--cred-color);
    }

    .cred-icon {
        width: 40px;
        height: 40px;
        border-radius: 12px;
        background: var(--cred-soft);
        color: var(--cred-color);
        border: 1px solid color-mix(in srgb, var(--cred-color) 25%, transparent);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .cred-icon svg {
        width: 20px;
        height: 20px;
    }

    .cred-copy {
        display: flex;
        flex-direction: column;
        text-align: left;
        min-width: 0;
        gap: 2px;
    }

    .cred-metric {
        font-size: 0.94rem;
        font-weight: 750;
        color: var(--text-main);
        line-height: 1.25;
    }

    .cred-label {
        font-size: 0.8rem;
        color: var(--text-muted);
        line-height: 1.3;
    }

    @media (max-width: 640px) {
        .author-card {
            padding: 1.15rem 1rem;
            gap: 0.9rem;
        }

        .author-top {
            flex-direction: column;
            align-items: center;
            text-align: center;
            gap: 0.65rem;
        }

        .avatar-ring {
            width: 86px;
            height: 86px;
        }

        .author-intro {
            align-items: center;
            text-align: center;
            gap: 4px;
        }

        .author-name {
            font-size: 1.55rem;
        }

        .author-role {
            font-size: 0.82rem;
        }

        .author-bio {
            font-size: 0.82rem;
            line-height: 1.42;
        }

        .author-website-pill {
            padding: 6px 12px;
            font-size: 0.78rem;
            margin-top: 4px;
        }

        .creds-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 8px;
            padding-top: 0.75rem;
        }

        .cred-item {
            padding: 10px;
            gap: 9px;
        }

        .cred-icon {
            width: 32px;
            height: 32px;
            border-radius: 9px;
        }

        .cred-icon svg {
            width: 16px;
            height: 16px;
        }

        .cred-metric {
            font-size: 0.82rem;
        }

        .cred-label {
            font-size: 0.72rem;
        }
    }
</style>
