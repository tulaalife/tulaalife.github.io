---
const currentLang = Astro.currentLocale || "en";
const scrollHintLabel =
    currentLang === "hi" ? "नीचे स्क्रॉल करें" : "Scroll down";
---

<button
    type="button"
    class="scroll-more-cue"
    id="scroll-more-cue"
    aria-label={scrollHintLabel}
>
    <svg
        class="cue-chevron"
        viewBox="0 0 24 24"
        width="20"
        height="20"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
    >
        <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
</button>

<script>
    document.addEventListener("astro:page-load", () => {
        const scrollCue = document.getElementById("scroll-more-cue");
        const scrollContainer = document.getElementById(
            "main-scroll-container",
        );
        if (!scrollCue || !scrollContainer) return;

        const sections = Array.from(
            scrollContainer.querySelectorAll(".scroll-section"),
        ) as HTMLElement[];

        let currentSectionIndex = 0;
        let idleTimer: ReturnType<typeof setTimeout> | null = null;

        function resetIdleTimer() {
            if (!scrollCue) return;
            scrollCue.classList.remove("is-idle-moving");
            if (idleTimer) clearTimeout(idleTimer);
            idleTimer = setTimeout(() => {
                if (!scrollCue.classList.contains("is-hidden")) {
                    scrollCue.classList.add("is-idle-moving");
                }
            }, 5000);
        }

        scrollCue.addEventListener("click", () => {
            resetIdleTimer();
            const nextSection = sections[currentSectionIndex + 1];
            if (nextSection) {
                nextSection.scrollIntoView({
                    behavior: "smooth",
                    block: "start",
                });
            }
        });

        const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        const activeIdx = sections.findIndex(
                            (s) => s === entry.target,
                        );
                        if (activeIdx !== -1) {
                            currentSectionIndex = activeIdx;
                        }
                        const isLast =
                            entry.target.id === "sanctuary-footer" ||
                            currentSectionIndex === sections.length - 1;
                        scrollCue.classList.toggle("is-hidden", isLast);
                        if (isLast) {
                            scrollCue.classList.remove("is-idle-moving");
                        }
                    }
                });
            },
            {
                root: scrollContainer,
                threshold: 0.45,
            },
        );

        sections.forEach((sec) => observer.observe(sec));

        const activityEvents = [
            "scroll",
            "wheel",
            "touchstart",
            "touchmove",
            "pointerdown",
            "keydown",
            "click",
        ];
        activityEvents.forEach((evt) => {
            scrollContainer.addEventListener(evt, resetIdleTimer, {
                passive: true,
            });
            window.addEventListener(evt, resetIdleTimer, { passive: true });
        });

        resetIdleTimer();
    });
</script>

<style>
    .scroll-more-cue {
        position: fixed;
        bottom: clamp(8px, 1.5vh, 14px);
        left: 50%;
        transform: translateX(-50%);
        z-index: 75;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 24px;
        padding: 0;
        border: none;
        background: transparent;
        color: var(--text-muted);
        opacity: 0.32;
        cursor: pointer;
        transition:
            opacity 0.35s ease,
            transform 0.35s ease,
            color 0.2s ease;
    }

    .scroll-more-cue:hover {
        opacity: 0.75;
        color: var(--primary);
    }

    .scroll-more-cue.is-idle-moving {
        opacity: 0.58;
    }

    .scroll-more-cue.is-idle-moving .cue-chevron {
        animation: subtleIdleFloat 2.2s ease-in-out infinite;
    }

    .scroll-more-cue.is-hidden {
        opacity: 0 !important;
        pointer-events: none;
        transform: translateX(-50%) translateY(8px);
    }

    @keyframes subtleIdleFloat {
        0%,
        100% {
            transform: translateY(-2px);
        }
        50% {
            transform: translateY(3px);
        }
    }
</style>
