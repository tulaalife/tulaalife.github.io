---
const currentLang = Astro.currentLocale || "en";

const pages =
    currentLang === "hi"
        ? [
              { id: "hero", label: "आपका प्लान" },
              { id: "app-preview", label: "ऐप अनुभव" },
              { id: "yoga-library", label: "योग थेरेपी" },
              { id: "mind-sleep", label: "ध्यान व नींद" },
              { id: "wellness-suite", label: "दैनिक ट्रैकर्स" },
              { id: "privacy-trust", label: "100% गोपनीयता" },
              { id: "sanctuary-footer", label: "डाउनलोड करें" },
          ]
        : [
              { id: "hero", label: "Your Plan" },
              { id: "app-preview", label: "App Experience" },
              { id: "yoga-library", label: "Yoga Therapy" },
              { id: "mind-sleep", label: "Mind & Sleep" },
              { id: "wellness-suite", label: "Daily Trackers" },
              { id: "privacy-trust", label: "100% Private" },
              { id: "sanctuary-footer", label: "Get Tulaa" },
          ];
---

<aside class="story-pager" id="story-pager" aria-label="Page navigation">
    {
        pages.map((p, idx) => (
            <button
                type="button"
                class:list={["pager-dot", { active: idx === 0 }]}
                data-target={p.id}
                aria-label={p.label}
            >
                <span class="pager-tooltip">{p.label}</span>
                <span class="pager-pip" />
            </button>
        ))
    }
</aside>

<script>
    document.addEventListener("astro:page-load", () => {
        const pager = document.getElementById("story-pager");
        const scrollContainer = document.getElementById(
            "main-scroll-container",
        );
        if (!pager || !scrollContainer) return;

        const dots = Array.from(
            pager.querySelectorAll(".pager-dot"),
        ) as HTMLButtonElement[];
        const sections = dots
            .map((btn) => {
                const id = btn.getAttribute("data-target");
                return id ? document.getElementById(id) : null;
            })
            .filter(Boolean) as HTMLElement[];

        dots.forEach((btn) => {
            btn.addEventListener("click", () => {
                const id = btn.getAttribute("data-target");
                const target = id ? document.getElementById(id) : null;
                if (target) {
                    target.scrollIntoView({
                        behavior: "smooth",
                        block: "start",
                    });
                }
            });
        });

        const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        const id = entry.target.id;
                        dots.forEach((dot) => {
                            dot.classList.toggle(
                                "active",
                                dot.getAttribute("data-target") === id,
                            );
                        });
                    }
                });
            },
            {
                root: scrollContainer,
                threshold: 0.45,
            },
        );

        sections.forEach((sec) => observer.observe(sec));
    });
</script>

<style>
    .story-pager {
        position: fixed;
        right: clamp(14px, 2.2vw, 28px);
        top: 50%;
        transform: translateY(-50%);
        z-index: 80;
        display: flex;
        flex-direction: column;
        gap: 10px;
        padding: 10px 7px;
        border-radius: 999px;
        background: color-mix(in srgb, var(--bg-elevated) 75%, transparent);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid var(--border);
        box-shadow: var(--shadow-sm);
    }

    .pager-dot {
        position: relative;
        width: 18px;
        height: 18px;
        border: none;
        background: none;
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
    }

    .pager-pip {
        width: 7px;
        height: 7px;
        border-radius: 999px;
        background: color-mix(in srgb, var(--text-muted) 45%, transparent);
        transition:
            transform 0.25s cubic-bezier(0.16, 1, 0.3, 1),
            background-color 0.25s ease,
            height 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .pager-dot:hover .pager-pip {
        background: var(--primary);
        transform: scale(1.25);
    }

    .pager-dot.active .pager-pip {
        background: var(--primary);
        height: 16px;
        width: 7px;
    }

    .pager-tooltip {
        position: absolute;
        right: 28px;
        white-space: nowrap;
        padding: 4px 10px;
        border-radius: 99px;
        background: var(--bg-elevated);
        border: 1px solid var(--border-strong);
        color: var(--text-main);
        font-size: 0.74rem;
        font-weight: 600;
        box-shadow: var(--shadow-sm);
        opacity: 0;
        pointer-events: none;
        transform: translateX(6px);
        transition:
            opacity 0.2s ease,
            transform 0.2s ease;
    }

    .pager-dot:hover .pager-tooltip {
        opacity: 1;
        transform: translateX(0);
    }

    @media (max-width: 960px) {
        .story-pager {
            display: none;
        }
    }
</style>
